data: {"type":"data-engineering","id":"7b239b15-c77e-449d-a809-428e54ee8f70","data":{"outputs":[],"id":"ace2cd79-c362-44d1-9d80-601553358ec0","type":"SINGLE_SELECT","text":"Welche hybride Bus-Strategie soll ich als Vorschlag anlegen?","title":"","context_refs":[],"question":{"id":"45fbd969-cf2b-4bd6-9b76-84e58e1ff717","question":"Welche hybride Bus-Strategie soll ich als Vorschlag anlegen?","description":"Das Modell ist aktuell leer. Ich plane: Echtzeitsteuerung ↔ 6 Aktoren und 8 einfache Sensorwerte über CAN-FD; Echtzeitsteuerung ↔ leistungsfähiger Rechner über Ethernet für hochauflösende Umgebungsdaten; Rechner ↔ Sensoren über USB/MIPI/GigE je nach Sensorart.","selection_mode":"SINGLE","options":[{"id":"can_fd_ethernet_hybrid","label":"CAN-FD für Echtzeit + Ethernet für Hochdaten","description":"Aktoren und einfache Sensorwerte auf CAN-FD; hochauflösende Umgebungsdaten über Ethernet zwischen Sensoren, Rechner und Echtzeitsteuerung.","recommended":true,"disabled":false,"reason":"","metadata":{}},{"id":"can_fd_only","label":"Nur CAN-FD","description":"Alle Geräte auf CAN-FD; Hochdatenrate wird eng, Timing-Prüfung kritisch.","recommended":false,"disabled":false,"reason":"","metadata":{}},{"id":"ethernet_only","label":"Nur Ethernet","description":"Alle Geräte über Ethernet; höhere Latenz und Komplexität für Echtzeit-Aktoren.","recommended":false,"disabled":false,"reason":"","metadata":{}}],"recommended_options":["can_fd_ethernet_hybrid"],"required":true,"engineering_impact":"REQUIRED","context_refs":[],"status":"OPEN"},"options":[],"actions":[],"findings":[],"progress":[],"metadata":{"run_id":"e4067f66-1e3b-4437-a7fd-71ed89c6194a","input_ref":"04add315-f73f-4b9e-b7d2-0a47460e7d68","decision_key":"robot_bus_strategy"},"created_at":"2026-09-16T07:05:00.305931+00:00","status":"","severity":""}}

