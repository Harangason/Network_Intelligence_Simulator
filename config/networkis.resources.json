        "model": "qwen3.8:27b",
        "fast_model": "llama3.1:8b",
        "api_key": "ollama"
      },
      "openai": {
        "enabled": 1,
        "active": 0,
        "uses_env_key": 1,
        "env_key": "OPENAI_API_KEY"
      },
      "nvidia": {
        "enabled": 0,
        "active": 0,
        "uses_env_key": 1,
        "env_key": "NVIDIA_API_KEY",
