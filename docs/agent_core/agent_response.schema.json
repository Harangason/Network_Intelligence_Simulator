{
  "$defs": {
    "AgentOutputEnvelope": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "output_id": {
          "title": "Output Id",
          "type": "string"
        },
        "output_type": {
          "enum": [
            "CHAT",
            "QUESTION",
            "MODEL_CHANGE",
            "FINDING",
            "PROPOSAL",
            "TABLE",
            "GRAPH",
            "DIAGRAM",
            "CHART",
            "TRACE_VIEW",
            "FILE",
            "REPORT",
            "CODE",
            "SIMULATION",
            "MCP_RESPONSE",
            "CALCULATION",
            "VALIDATION",
            "VISUALIZATION"
          ],
          "title": "Output Type",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "project_ref": {
          "title": "Project Ref",
          "type": "string"
        },
        "run_ref": {
          "title": "Run Ref",
          "type": "string"
        },
        "content": {
          "default": "",
          "title": "Content",
          "type": "string"
        },
        "affected_objects": {
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "title": "Affected Objects",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "title": "Evidence Refs",
          "type": "array"
        },
        "visualization": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisualizationRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "validation": {
          "additionalProperties": true,
          "title": "Validation",
          "type": "object"
        },
        "provenance": {
          "additionalProperties": true,
          "title": "Provenance",
          "type": "object"
        }
      },
      "required": [
        "output_id",
        "output_type",
        "status",
        "project_ref",
        "run_ref"
      ],
      "title": "AgentOutputEnvelope",
      "type": "object"
    },
    "InteractiveOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "recommended": {
          "default": false,
          "title": "Recommended",
          "type": "boolean"
        },
        "disabled": {
          "default": false,
          "title": "Disabled",
          "type": "boolean"
        },
        "reason": {
          "default": "",
          "maxLength": 2000,
          "title": "Reason",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "InteractiveOption",
      "type": "object"
    },
    "InteractiveQuestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "selection_mode": {
          "default": "SINGLE",
          "enum": [
            "SINGLE",
            "MULTI"
          ],
          "title": "Selection Mode",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/InteractiveOption"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "recommended_options": {
          "items": {
            "type": "string"
          },
          "title": "Recommended Options",
          "type": "array"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "engineering_impact": {
          "default": "REQUIRED",
          "enum": [
            "OPTIONAL",
            "REQUIRED",
            "CRITICAL"
          ],
          "title": "Engineering Impact",
          "type": "string"
        },
        "context_refs": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Context Refs",
          "type": "array"
        },
        "status": {
          "default": "OPEN",
          "enum": [
            "OPEN",
            "ANSWERED",
            "SKIPPED",
            "EXPIRED",
            "OUTDATED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "question",
        "options"
      ],
      "title": "InteractiveQuestion",
      "type": "object"
    },
    "VisualizationEdge": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "evidence_ref": {
          "title": "Evidence Ref",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "evidence_ref"
      ],
      "title": "VisualizationEdge",
      "type": "object"
    },
    "VisualizationNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "object_type": {
          "title": "Object Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "object_type"
      ],
      "title": "VisualizationNode",
      "type": "object"
    },
    "VisualizationRequest": {
      "additionalProperties": false,
      "properties": {
        "visualization_type": {
          "enum": [
            "NETWORK_DIAGRAM",
            "TABLE"
          ],
          "title": "Visualization Type",
          "type": "string"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "source_revision": {
          "title": "Source Revision",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/VisualizationNode"
          },
          "maxItems": 200,
          "title": "Nodes",
          "type": "array"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/VisualizationEdge"
          },
          "maxItems": 400,
          "title": "Relationships",
          "type": "array"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 200,
          "title": "Rows",
          "type": "array"
        },
        "total_objects": {
          "default": 0,
          "minimum": 0,
          "title": "Total Objects",
          "type": "integer"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "visualization_type",
        "purpose",
        "source_revision"
      ],
      "title": "VisualizationRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "outputs": {
      "items": {
        "$ref": "#/$defs/AgentOutputEnvelope"
      },
      "maxItems": 20,
      "title": "Outputs",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "type": {
      "enum": [
        "TEXT",
        "QUESTION",
        "MULTI_SELECT",
        "SINGLE_SELECT",
        "RECOMMENDATION",
        "FINDING",
        "PROGRESS",
        "RESULT",
        "APPROVAL",
        "ERROR"
      ],
      "title": "Type",
      "type": "string"
    },
    "text": {
      "default": "",
      "maxLength": 30000,
      "title": "Text",
      "type": "string"
    },
    "title": {
      "default": "",
      "maxLength": 300,
      "title": "Title",
      "type": "string"
    },
    "context_refs": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "maxItems": 100,
      "title": "Context Refs",
      "type": "array"
    },
    "question": {
      "anyOf": [
        {
          "$ref": "#/$defs/InteractiveQuestion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "options": {
      "items": {
        "$ref": "#/$defs/InteractiveOption"
      },
      "title": "Options",
      "type": "array"
    },
    "actions": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "maxItems": 12,
      "title": "Actions",
      "type": "array"
    },
    "findings": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "maxItems": 100,
      "title": "Findings",
      "type": "array"
    },
    "progress": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "maxItems": 20,
      "title": "Progress",
      "type": "array"
    },
    "recommendation": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recommendation"
    },
    "approval": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "proposal": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposal"
    },
    "workload": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workload"
    },
    "status": {
      "default": "",
      "title": "Status",
      "type": "string"
    },
    "severity": {
      "default": "",
      "title": "Severity",
      "type": "string"
    }
  },
  "required": [
    "type"
  ],
  "title": "AgentResponse",
  "type": "object"
}
