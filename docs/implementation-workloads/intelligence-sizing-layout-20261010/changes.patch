+.communication-sizing-panel[open] > .communication-sizing-summary .communication-sizing-chevron { transform: rotate(180deg); }
+.communication-sizing-body { display: grid; gap: 18px; padding: 20px 24px 24px; border-top: 1px solid var(--border); }
+.communication-sizing-body p { margin: 0; font-size: 12px; line-height: 1.65; overflow-wrap: anywhere; }
+.communication-sizing-intro { max-width: 100ch; color: var(--muted); }
