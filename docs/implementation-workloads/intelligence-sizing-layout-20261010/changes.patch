+.communication-sizing-fields label { display: grid; align-content: start; gap: 8px; min-width: 0; color: var(--muted); font-size: 11px; line-height: 1.4; }
+.communication-sizing-fields input { width: 100%; min-width: 0; min-height: 40px; border: 1px solid var(--border); border-radius: 6px; padding: 9px 11px; color: var(--text); background: var(--background); font: 13px var(--font-geist-mono), monospace; }
+.communication-sizing-fields input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+.communication-sizing-fields input:disabled { opacity: .6; }
+.communication-sizing-actions { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding-top: 16px; border-top: 1px solid var(--border); }
+.communication-sizing-actions > span { color: var(--muted); font-size: 11px; line-height: 1.5; }
+.communication-sizing-actions > .button { margin-left: auto; max-width: 100%; white-space: normal; text-align: center; }
+.communication-sizing-result { display: grid; gap: 14px; padding-top: 18px; border-top: 1px solid var(--border); min-width: 0; }
+.communication-sizing-result-heading { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 16px; }
+.communication-sizing-result-heading strong { color: var(--text); font-size: 14px; }
+.communication-sizing-result-heading span { color: var(--muted); font-size: 11px; }
+.communication-sizing-networks { display: grid; gap: 8px; min-width: 0; max-height: 520px; overflow: auto; }
+.communication-sizing-network, .communication-sizing-changes { min-width: 0; padding: 12px 14px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface-deep); }
+.communication-sizing-network > summary, .communication-sizing-changes > summary { cursor: pointer; color: var(--text); font-size: 12px; line-height: 1.6; overflow-wrap: anywhere; }
