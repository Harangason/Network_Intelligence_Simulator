+.communication-sizing-icon { display: grid; place-items: center; flex: 0 0 42px; height: 42px; border-radius: 10px; color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, var(--surface)); }
+.communication-sizing-heading { display: grid; gap: 5px; min-width: 0; }
+.communication-sizing-heading strong { color: var(--text); font-size: 17px; line-height: 1.35; }
