 .signal-selection-name { appearance:none; padding:0; border:0; background:transparent; color:inherit; font:inherit; font-weight:700; text-align:left; cursor:pointer; }
 .signal-selection-name:focus-visible { outline:2px solid var(--accent); outline-offset:4px; }
 @media(max-width:800px) { .analysis-compare-sides {grid-template-columns:1fr;} .analysis-window-tools > header {align-items:flex-start;flex-direction:column;} .analysis-window-actions > * {flex:1 1 200px;} }
+
+/* Fault parameters carry visible units and engine-backed explanations. */
+.fault-builder { grid-template-columns:repeat(3,minmax(0,1fr)); align-items:start; }
+.fault-builder > label { display:grid; gap:6px; min-width:0; margin:0; }
+.fault-builder > label > span { color:var(--muted); font-size:11px; }
+.fault-builder small { color:var(--muted); font-size:11px; line-height:1.5; overflow-wrap:anywhere; }
+.fault-builder input,.fault-builder select { min-width:0; }
+.fault-builder input:disabled { opacity:.6; cursor:not-allowed; }
+.fault-builder > button { grid-column:1 / -1; justify-self:start; }
+.fault-description { display:grid; gap:8px; padding:14px; margin-block:14px; border:1px solid var(--border); border-radius:6px; background:var(--background); font-size:12px; line-height:1.6; overflow-wrap:anywhere; }
+.fault-description > strong { display:flex; gap:8px; flex-wrap:wrap; }
+.fault-description > span { color:var(--muted); }
+.fault-description code,.fault-glossary code { color:var(--muted); font-size:11px; overflow-wrap:anywhere; }
+.fault-glossary { margin-block:14px; }
+.fault-glossary summary { cursor:pointer; font-size:12px; }
+.fault-glossary section { margin-top:16px; }
+.fault-glossary h3 { font-size:13px; }
+.fault-glossary dl { margin:0; }
+.fault-glossary dl > div { padding-block:10px; border-top:1px solid var(--border); }
+.fault-glossary dt { display:flex; flex-wrap:wrap; gap:8px; font-size:12px; font-weight:600; }
+.fault-glossary dd { margin:6px 0 0; color:var(--muted); font-size:12px; line-height:1.6; overflow-wrap:anywhere; }
+@media(max-width:760px) { .fault-builder {grid-template-columns:repeat(2,minmax(0,1fr));} }
+@media(max-width:480px) { .fault-builder {grid-template-columns:1fr;} }
