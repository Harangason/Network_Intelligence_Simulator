{
  "schema_version": 1,
  "project": {
    "name": "Network Intelligence Simulator",
    "root": "I:\\PycharmProjects\\My_first_Network_Simulator",
    "frontend_url": "http://127.0.0.1:13500",
    "backend_url": "http://127.0.0.1:15050"
  },
  "paths": {
    "docker_cli": "C:\\Users\\marti\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe",
    "docker_compose": "C:\\Users\\marti\\.docker\\cli-plugins\\docker-compose.exe",
    "docker_desktop": "C:\\Users\\marti\\AppData\\Local\\Programs\\DockerDesktop\\Docker Desktop.exe",
    "ollama_cli": "C:\\Users\\marti\\AppData\\Local\\Programs\\Ollama\\ollama.exe",
    "ollama_models": "I:\\engineering-intelligence-platform\\models\\ollama",
    "runtime_root": "backend\\runtime",
    "service_logs": "backend\\runtime\\service-logs"
  },
  "docker": {
    "compose_file": "docker-compose.networkis.yml",
    "gpu_compose_file": "docker-compose.networkis.gpu.yml",
    "networkis_service": "networkis",
    "database_service": "networkis-db",
    "networkis_container": "NetworkIS",
    "database_container": "NetworkIS-db",
    "frontend_port": 13500,
    "backend_port": 15050,
    "host_metrics_port": 13502,
    "database_port": 5432,
    "restart_policy": "unless-stopped"
  },
  "resources": {
    "waitress_threads": 16,
    "simulation_executor": "thread",
    "simulation_workers": 12,
    "workflow_event_limit": 100000,
    "service_restarts": 5,
    "numeric_threads": 1,
    "ollama_context_length": 8192,
    "ollama_keep_alive": "10m",
    "ollama_fast_keep_alive": "30m",
    "numeric_accelerator": "auto",
    "numeric_accelerator_min_items": 256,
    "compute_policy": {
      "policy_version": 1,
      "rule": "CPU steuert und persistiert; GPU beschleunigt ausschließlich geeignete, seiteneffektfreie Batch-Berechnungen und lokale KI-Inferenz.",
      "cpu_authoritative_tasks": [
        "Datenbankzugriffe, CRUD und Transaktionen",
        "Projekt-Locks und Workflow-Steuerung",
        "Validierung, Regelwerke und kanonische Modelländerungen",
        "Numerische Arbeit unterhalb der konfigurierten Batch-Schwelle",
        "Fallback bei fehlender oder fehlerhafter CUDA-Laufzeit"
      ],
      "gpu_accelerated_tasks": [
        "Deterministische Trace-Statistiken der Simulation",
        "Deterministische Capacity- und Netzlast-Aggregationen",
        "Lokale semantische KI-Aufgaben über Ollama"
      ],
      "numeric_selection": {
        "mode_from": "resources.numeric_accelerator",
        "minimum_items_from": "resources.numeric_accelerator_min_items",
        "required_runtime": "NVIDIA Container Runtime und CuPy CUDA",
        "fallback": "CPU",
        "deterministic_results_required": true,
        "gpu_side_effects_allowed": false
      },
      "ai_selection": {
        "semantic_fast_model_from": "ai.providers.ollama.fast_model",
        "deep_model_from": "ai.providers.ollama.model",
        "fast_model_keep_alive_from": "resources.ollama_fast_keep_alive",
        "fallback": "konfigurierter Hybrid-/Cloud-Pfad"
      },
      "telemetry": {
        "preferred_source": "Windows-Hosttelemetrie",
        "gpu_fallback_source": "NVIDIA-Metriken im Container"
      }
    },
    "memory_budget": {
      "backend_hot_cache_mb": 1024,
      "frontend_runtime_mb": 1024,
      "trace_artifact_soft_limit_mb": 2048
    }
  },
  "ai": {
    "active_provider": "hybrid-demand",
    "cloud_escalation": "on_failure",
    "providers": {
      "ollama": {
        "enabled": 1,
        "active": 1,
        "base_url_windows": "http://127.0.0.1:11434/v1",
        "base_url_docker": "http://host.docker.internal:11434/v1",
        "model": "qwen3.8:27b",
        "fast_model": "llama3.1:8b",
        "api_key": "ollama"
      },
      "openai": {
        "enabled": 1,
        "active": 0,
        "uses_env_key": 1,
        "env_key": "OPENAI_API_KEY"
      },
      "nvidia": {
        "enabled": 0,
        "active": 0,
        "uses_env_key": 1,
        "env_key": "NVIDIA_API_KEY",
        "model": "nvidia/nemotron-3-nano-30b-a3b"
      }
    }
  }
}
