+                return httpx.Response(status, json={'error': error})
+            response = {'model': 'local-completion:4b', 'done': True,
+                'message': {'content': json.dumps({'content': '', 'tool_calls': [
+                    {'function': {'name': 'inspect_project', 'arguments': {'revision': 2}}}]})}}
