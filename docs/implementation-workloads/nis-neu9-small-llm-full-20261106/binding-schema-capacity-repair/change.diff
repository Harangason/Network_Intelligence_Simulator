+                fields = {key: deepcopy(value) for key, value in row.items() if key not in {'id', 'device_id'}}
+                equal = next((group for group in record['connections']
+                              if {key: value for key, value in group.items() if key != 'count'} == fields), None)
+                if equal is None:
+                    record['connections'].append({**fields, 'count': 1})
+                else:
+                    equal['count'] += 1
+            candidate.update(port_groups_by_device=grouped, port_plan_complete=True, ports=[])
+        if 'port_intents' in payload['format']['properties'] and not duplicate_port_ids:
+            # Model native technical choices, not a fabricated identity answer.
+            # The explicit duplicate-ID bypass fixture remains unchanged.
+            rows = candidate.get('ports', [])
+            if foreign_io not in allowed and not retry_foreign_port:
+                from collections import Counter
+                def signature(row):
+                    return tuple(row[key] for key in ('device_id', 'technology', 'role', 'network_scope'))
+                existing = Counter(signature(row) for row in content['current_candidate']['ports'])
+                pending = []
+                for row in rows:
+                    key = signature(row)
+                    if existing[key]:
+                        existing[key] -= 1
+                    else:
+                        pending.append(row)
+                candidate['port_intents_complete'] = len(pending) <= 1
+                rows = pending[:1]
+            else:
+                # Preserve deliberately invalid authored records in full.
+                candidate['port_intents_complete'] = True
+            candidate['port_intents'] = [{key: deepcopy(value) for key, value in row.items() if key != 'id'}
+                                         for row in rows]
+            candidate['ports'] = []
+        if 'port_parameters' in payload['format']['properties']:
+            rows = candidate.get('ports', [])
+            prior = {row['id']: row for row in content['current_candidate']['ports']}
+            # Convert only a valid authored selection. Never deduplicate or
+            # erase an intentionally foreign/rewritten fixture identity.
+            if (len({row['id'] for row in rows}) == len(rows)
+                    and all(row['id'] in prior and all(row[key] == prior[row['id']][key]
+                        for key in ('id', 'device_id', 'technology', 'role', 'network_scope')) for row in rows)):
+                candidate['port_parameters'] = {row['id']: {
+                    'parameters': deepcopy(row['parameters']), 'rationale': row['rationale'],
+                    'field_references': deepcopy(row.get('field_references', {}))} for row in rows}
+                candidate['ports'] = []
+        if 'functions_by_fact' in payload['format']['properties']:
+            rows = candidate.get('functions', [])
+            if len({row['source_fact_id'] for row in rows}) == len(rows):
+                candidate['functions_by_fact'] = {row['source_fact_id']: {
+                    key: deepcopy(value) for key, value in row.items() if key != 'source_fact_id'} for row in rows}
+                candidate['functions'] = []
+        native_content = (' \n' if wire_padding else '') + json.dumps(candidate) + ('\n ' if wire_padding else '')
+        return httpx.Response(200, json={'message': {'content': native_content}, 'done': True, 'done_reason': 'length' if truncate else 'stop',
+                                       'prompt_eval_count': 500, 'eval_count': 500})
+    instance = LocalEngineeringReasoner()
+    asyncio.run(instance.client.aclose())
+    instance.client = httpx.AsyncClient(transport=httpx.MockTransport(handler))
+    return instance, prepared, observed
+
