+DIR = Path(__file__).resolve().parent
+GOAL = DIR.parent
+parser = argparse.ArgumentParser()
+parser.add_argument('--model', choices=['llama3.1:8b', 'qwen3.5:9b'], default='llama3.1:8b')
+parser.add_argument('--shared-fields-counter', action='store_true')
