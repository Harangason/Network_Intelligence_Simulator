+            checked={allSelected}
+            disabled={busy}
+            onChange={(event) => setSelections(event.target.checked ? leaves.map((leaf) => leaf.name) : [])}
+            type="checkbox"
+          />
+          <span>{allSelected ? "Alle ausgewählt" : "Alle auswählen"}</span>
+        </label>
+        <strong>{selections.length} ausgewählt</strong>
