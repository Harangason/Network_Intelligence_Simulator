+        <small>{entries.length} Schritte</small>
+      </summary>
+      <ol>
+        {entries.map((entry) => (
+          <li className={`activity-${entry.kind}`} key={entry.id}>
+            <strong>{entry.title}</strong>
+            <span>{entry.detail}</span>
+          </li>
+        ))}
