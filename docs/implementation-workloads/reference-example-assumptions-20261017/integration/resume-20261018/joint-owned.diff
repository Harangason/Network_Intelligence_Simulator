+function AgentFeedbackControls({
+  messageId,
+  projectId,
+  prompt,
+  response,
+}: {
+  messageId: string;
+  projectId: string;
+  prompt: string;
+  response: string;
+}) {
+  const [mode, setMode] = useState<"idle" | "incorrect" | "saved">("idle");
