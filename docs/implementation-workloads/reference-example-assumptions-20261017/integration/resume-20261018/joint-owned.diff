-      <ul className="eng-agent-list" key={`list-${blocks.length}`}>
-        {bulletItems.map((item) => <li key={item.key}>{renderInlineMarkup(item.text)}</li>)}
-      </ul>,
-    );
-    bulletItems = [];
-  }
-
-  lines.forEach((line, index) => {
-    const trimmed = line.trim();
-    if (!trimmed) {
-      flushBullets();
