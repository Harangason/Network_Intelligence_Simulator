+  if (part.type.startsWith("tool-")) {
+    return <ToolCallCard
+      label={`Routing · ${part.type.replace("tool-", "").replaceAll("_", " ")}`}
+      part={part as { state: string; input?: unknown; output?: unknown; errorText?: string }}
+      projectId={projectId}
+    />;
