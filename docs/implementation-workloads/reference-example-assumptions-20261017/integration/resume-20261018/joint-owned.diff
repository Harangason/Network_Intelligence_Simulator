+            aria-label={`${leaf.name} für Mehrfachzuordnung auswählen`}
+            checked={selections.includes(leaf.name)}
+            disabled={busy}
+            onChange={(event) => setSelections((current) => event.target.checked ? [...current, leaf.name] : current.filter((name) => name !== leaf.name))}
