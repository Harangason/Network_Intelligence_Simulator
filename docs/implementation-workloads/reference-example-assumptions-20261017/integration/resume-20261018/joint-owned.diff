+    prefix = re.split(r'[.!?;,\n]|\b(?:sondern|but|instead|und|and)\b', text[:match.start()], flags=re.I)[-1]
+    if re.search(r'\b(?:kein\w*|nicht|ohne|nix|no|not|non)\b', ' '.join(prefix.split()[-4:]), re.I):
