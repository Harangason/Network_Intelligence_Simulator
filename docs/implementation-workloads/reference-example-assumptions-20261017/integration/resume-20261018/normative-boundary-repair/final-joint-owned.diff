-function identifier(value: string) {
-  const words = value.replace(/[^a-zA-Z0-9äöüÄÖÜß]+/g, " ").trim().split(/\s+/);
-  return words.map((word) => word.charAt(0).toUpperCase() + word.slice(1)).join("");
-}
