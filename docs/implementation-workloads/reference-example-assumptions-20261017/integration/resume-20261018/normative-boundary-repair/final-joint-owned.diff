+  for (const key of ["sensors", "actuators", "ecus", "gateways"] as const) {
+    if (!Number.isSafeInteger(counts[key]) || counts[key] < 0 || counts[key] > 1000) {
+      throw new Error(`Ungueltiger Hardware-Sollwert: ${key}`);
+    }
+  }
+  return counts;
