+def document_device_aliases(source: str):
+    return {match[1] for match in re.finditer(r'\b' + _DOCUMENT_CONTROLLER_LABEL + r'\s*\(([A-Z][A-Z0-9_-]{1,15})\)', source, re.I)}
+
