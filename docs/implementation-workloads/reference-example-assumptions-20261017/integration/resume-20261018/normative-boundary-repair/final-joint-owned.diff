+  const countAfterPattern = new RegExp(`\\b${modifiers}${nounPattern}\\b\\s*(?:anzahl|countsep)\\s*${COUNT_TOKEN}\\b`, "g");
+  const countAfterBareLinePattern = new RegExp(`^${modifiers}${nounPattern}\\s+${COUNT_TOKEN}$`, "g");
