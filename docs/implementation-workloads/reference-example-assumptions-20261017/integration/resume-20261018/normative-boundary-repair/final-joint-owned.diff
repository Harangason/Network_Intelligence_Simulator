+        role = communication.get('role') or ('COMMAND' if any(by_device[key]['kind'] == 'ACTUATOR' for key in communication['consumer_device_ids'])
+                else 'MEASUREMENT' if by_device[communication['producer_device_id']]['kind'] == 'SENSOR'
