+function documentChapterKind(caption: string) {
+  const title = caption.normalize('NFKC').replace(/[\u2010-\u2015\u2212]/g, '-').replace(/^\d+(?:\.\d+)*[.)]?\s+/u, '').replace(/:\s*$/u, '').trim();
