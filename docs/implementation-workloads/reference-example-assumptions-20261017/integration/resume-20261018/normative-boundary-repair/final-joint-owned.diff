+def generate_parameters(arguments: dict) -> dict:
+    """Persist confirmed registry defaults without delegating tool choice to an LLM."""
+    prompt = effective_wizard_prompt(arguments['prompt'])
+    workflow = WorkflowStatusService(current_project_id())
+    state = workflow.get()
+    if arguments.get('sizing_only'):
+        # A reviewed physical topology and complete saved configuration own
+        # this continuation. Do not regenerate their defaults or spatial plan.
+        artifact_check = state['artifact_checks']['parameters']
+        if not artifact_check['complete'] or not state['artifact_checks']['network_editor']['complete']:
+            raise ValueError('Erneute Kommunikationsauslegung benötigt vollständige gespeicherte Parameter und Netzwerktopologie.')
+        parameters = state['parameters']
+        from backend.nis.engineering.capacity.sizing_service import CommunicationSizingService
+        from backend.nis.engineering.capacity.dimensioning import policy_for
+        sizing = None
+        if policy_for(parameters)['enabled']:
+            service = CommunicationSizingService(current_project_id())
+            sizing = service.preview()
+            if sizing['changes']:
+                service.apply(sizing['source_token'], actor=str(arguments.get('_actor') or 'engineering-agent'), approve_valid=True)
+                state = workflow.get()
+        return {'status': state['statuses']['parameters'], 'parameters': state['parameters'],
+                'artifact_check': artifact_check, 'source': 'saved-project-configuration',
+                'technology_ids': list((parameters.get('simulation_parameter_assumptions') or {}).keys()),
+                'communication_dimensioning': sizing}
+    technology_ids = _wizard_parameter_technology_ids(prompt)
+    for route in model.routes():
+        protocol = str((route.get('source') or {}).get('protocol') or '')
+        try:
+            technology_id = DEFAULT_TECHNOLOGY_REGISTRY.normalize_id(protocol)
+            DEFAULT_TECHNOLOGY_REGISTRY.profile(technology_id)
+        except (KeyError, ValueError):
+            continue
+        if technology_id not in technology_ids:
+            technology_ids.append(technology_id)
+    if not technology_ids:
+        raise ValueError('Keine registrierte Netzwerktechnologie für die Parameter-Defaults gefunden.')
+
+    domain_match = re.search(r'^- Projekt-Modelltyp:\s*([^\r\n]+)', prompt, re.M)
+    industry = (domain_match.group(1).strip() if domain_match else '') or str(
+        (state.get('parameters') or {}).get('industry') or 'generic_networking'
+    )
+    explicit_rates = _explicit_technology_bitrates(prompt, technology_ids)
+    can_fd_phases = _explicit_can_fd_phases(prompt, technology_ids)
+    if can_fd_phases:
+        explicit_rates['can_fd'] = can_fd_phases['data_bitrate']
+    review_candidates = {technology_id: _rate_review_candidate(technology_id) for technology_id in technology_ids}
+    technology_defaults = {technology_id: {
+        **_parameter_defaults(technology_id),
+        **({'bitrate': review_candidates[technology_id][0]}
+           if 'bitrate' not in _parameter_defaults(technology_id) and review_candidates[technology_id][0] else {}),
+        **({'bitrate': explicit_rates[technology_id]} if technology_id in explicit_rates else {}),
+        **(can_fd_phases if technology_id == 'can_fd' else {}),
+    } for technology_id in technology_ids}
+    primary = technology_ids[0]
+    primary_defaults = technology_defaults[primary]
+    existing = dict(state.get('parameters') or {})
+    if DEFAULT_TECHNOLOGY_REGISTRY.normalize_id(existing.get('technology')) != primary:
+        # Global transport values belong to their previous technology. Scoped
+        # groups/networks remain saved and can be selected independently.
+        transport_keys = {field['key'] for field in SimulationService._parameter_schema(
+            primary, DEFAULT_TECHNOLOGY_REGISTRY.profile(primary)) if field['category'] == 'physical'}
+        old_technology = existing.get('technology')
+        if old_technology:
+            transport_keys.update(field['key'] for field in SimulationService._parameter_schema(
+                old_technology, DEFAULT_TECHNOLOGY_REGISTRY.profile(old_technology)) if field['category'] == 'physical')
+        transport_keys.update({'bitrate', 'bitrate_bps', 'nominal_bitrate_bps', 'data_bitrate_bps',
+                               'arbitration_bitrate', 'data_bitrate', 'local_timing_evidence'})
+        existing = {key: value for key, value in existing.items() if key not in transport_keys}
+        existing['parameter_provenance'] = {key: value for key, value in (existing.get('parameter_provenance') or {}).items() if key not in transport_keys}
+    parameters = {
+        **primary_defaults,
+        **existing,
+        # Prompt rates seed a new configuration via primary_defaults. A resumed
+        # run must retain the later saved project values and their provenance.
+        'industry': industry,
+        'technology': primary,
+        'formats': list(existing.get('formats') or ['universal-jsonl', 'universal-csv']),
+        'technology_defaults': technology_defaults,
+        'defaults_source': 'technology-registry-with-explicit-user-rates' if explicit_rates else 'technology-registry',
+        'explicit_technology_bitrates': explicit_rates,
+        'rate_review_proposals': {technology_id: proposal for technology_id, (_candidate, proposal) in review_candidates.items() if proposal},
+        'spatial_architecture': architecture_from(existing, prompt),
+    }
+    if primary in explicit_rates:
+        parameters['parameter_provenance'] = {
+            **(existing.get('parameter_provenance') or {}),
+            **({'bitrate': {'source': 'EXPLICIT_USER_SPECIFICATION', 'value': explicit_rates[primary]}}
+               if 'bitrate' not in existing else {}),
+            **({key: {'source': 'EXPLICIT_USER_SPECIFICATION', 'value': value}
+                for key, value in can_fd_phases.items() if key not in existing} if primary == 'can_fd' else {}),
+        }
+    elif not existing.get('bitrate') and review_candidates[primary][0]:
+        parameters['parameter_provenance'] = {
+            **(existing.get('parameter_provenance') or {}),
+            'bitrate': {'source': 'TECHNOLOGY_PROFILE_REVIEW_PROPOSAL',
+                        'status': 'REVIEW_REQUIRED', 'value': review_candidates[primary][0]},
+        }
+    if 'duration_s' not in existing and 'duration_s' in primary_defaults:
+        parameters['parameter_provenance'] = {
+            **(parameters.get('parameter_provenance') or {}),
+            'duration_s': {'source': 'TECHNOLOGY_DEFAULT', 'value': primary_defaults['duration_s']},
+        }
+
+    parameters = DEFAULT_TECHNOLOGY_REGISTRY.simulation_defaults_for_project(parameters, technology_ids)
+    saved = workflow.save_parameters(
+        parameters, actor=str(arguments.get('_actor') or 'engineering-agent')
+    )
+    artifact_check = saved['artifact_checks']['parameters']
+    # Keep unresolved proposals reviewable; downstream gates use real completeness.
+    if not artifact_check['complete']:
+        missing = [key for key, ok in artifact_check['required'].items() if not ok]
+        findings = [{**finding, 'object_type': 'Workflow', 'object_id': primary,
+                     'technology_id': primary,
+                     'recommendation': 'Technologieparameter öffnen, fehlende Geräte-/Transaktionsangaben mit Quelle ergänzen und bestätigen.'}
+                    for finding in artifact_check.get('profile_findings', [])]
+        covered = {finding.get('parameter') for finding in findings}
+        findings.extend({'code': 'TECHNOLOGY_PARAMETER_MISSING', 'severity': 'REVIEW',
+                         'parameter': key, 'object_type': 'Workflow', 'object_id': primary,
+                         'technology_id': primary,
+                         'message': f'{primary}: {key} fehlt als geprüfter Projektwert.',
+                         'recommendation': 'Technologieparameter öffnen und diesen Wert mit seiner Nachweisquelle prüfen.'}
+                        for key in missing if key != 'profile_values' and key not in covered)
+        return {'parameters': parameters, 'technology_ids': technology_ids, 'artifact_check': artifact_check,
+                'status': 'REVIEW_REQUIRED', 'missing_parameters': missing, 'parameter_findings': findings}
+
+    sizing = None
+    if not parameters.get('spatial_zoning'):
+        from backend.nis.engineering.structure.zoning_service import SpatialZoningService
+        zoning = SpatialZoningService(current_project_id())
+        zone_plan = zoning.plan(driving_side_from_prompt(prompt))
+        zoning_result = zoning.apply(zone_plan['token'], driving_side_from_prompt(prompt),
+                                     actor=str(arguments.get('_actor') or 'engineering-agent'), approve_valid=True)
+        saved = workflow.get()
+        parameters = saved['parameters']
+        # Zoning has already dimensioned and checked these new physical buses.
+        # Reuse that exact result; no model/configuration edit intervenes here.
+        sizing = zoning_result['dimensioning']['plan']
+    # Parameter generation follows physical routing. Dimension the complete bus
+    # traffic here, before capacity/network splitting, using the same service as
+    # the workbench. Explicit user/import timing remains locked.
+    from backend.nis.engineering.capacity.sizing_service import CommunicationSizingService
+    from backend.nis.engineering.capacity.dimensioning import policy_for
+    if sizing is None and policy_for(parameters)["enabled"]:
+        sizing_service = CommunicationSizingService(current_project_id())
+        sizing = sizing_service.preview()
+        if sizing["changes"]:
+            sizing_service.apply(sizing["source_token"], actor=str(arguments.get('_actor') or 'engineering-agent'), approve_valid=True)
+            saved = workflow.get()
+    return {
+        'status': saved['statuses']['parameters'],
+        'parameters': saved['parameters'],
+        'artifact_check': artifact_check,
+        'technology_ids': technology_ids,
+        'source': 'technology-registry',
+        'communication_dimensioning': sizing,
+    }
