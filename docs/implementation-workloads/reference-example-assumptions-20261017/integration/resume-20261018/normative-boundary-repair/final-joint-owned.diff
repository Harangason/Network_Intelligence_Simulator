-function baseName(name: string) {
-  return normalizeHardwareName(name)
-    .replace(/[-_\s]*(sensor|ecu|gateway|plc|controller|steuergeraet)$/i, "")
-    .replace(/[^a-zA-Z0-9äöüÄÖÜß]+/g, " ")
-    .trim() || name;
-}
