+function sourceScopedDuties(lines: string[], originalLines: string[]) {
+  let active = false;
+  const duties: Array<{ name: string; source_quote: string }> = [];
+  const sourceKey = (line: string) => line.trim().replace(/[\u2010\u2011\u2212]/g, '-').replace(/\u00ad/g, '');
