+def verify_source_baseline(components, approved_components, historical):
+    """Keep exact reviewed facts and historical literals, independently of grouping."""
+    facts = {document_fact_identity(row): row for row in components}
+    approved = {document_fact_identity(row): row for row in approved_components}
+    assert len(facts) == len(components), 'Duplicate reference source facts'
+    assert len(approved) == len(approved_components), 'Duplicate approved intake facts'
+    assert facts.keys() == approved.keys(), 'Reference source facts differ from the reviewed original intake'
+    # The identity function defines the six original source fields. Require
+    # those values too, without relying only on their derived digest.
+    for key, row in facts.items():
+        for field in ('name', 'kind', 'role', 'quantity', 'source_quote', 'source_context'):
+            assert row.get(field) == approved[key].get(field), 'Reviewed source field changed: ' + field
+    for old in historical:
+        witnesses = [row for row in components
+                      if row.get('source_context', []) == old.get('source_context', [])
+                      and old['source_quote'] in row['source_quote']]
+        assert witnesses, 'Historical literal source or context missing: ' + repr(old)
+        if old['kind'] == 'INSTANCE':
+            assert any(row['kind'] == 'INSTANCE' and row['role'] == old['role']
+                       and row['quantity'] == old['quantity'] for row in witnesses), 'Explicit original instance changed'
+        elif old['role'] != 'OTHER':
+            assert any(row['kind'] == old['kind'] and row['role'] == old['role']
+                       and row['quantity'] == old['quantity'] for row in witnesses), 'Explicit original inventory role/count changed'
+    return facts
+
