+def _reference_context_patch(previous, current, path=''):
+    """Encode the complete private context losslessly as RFC6902 updates."""
+    from copy import deepcopy
+    if isinstance(previous, dict) and isinstance(current, dict):
+        patch = []
+        def pointer(key):
+            return path + '/' + key.replace('~', '~0').replace('/', '~1')
+        for key in previous:
+            if key not in current:
+                patch.append({'op': 'remove', 'path': pointer(key)})
+        for key, value in current.items():
+            if key not in previous:
+                patch.append({'op': 'add', 'path': pointer(key), 'value': deepcopy(value)})
+            else:
+                patch.extend(_reference_context_patch(previous[key], value, pointer(key)))
+        return patch
+    if isinstance(previous, list) and isinstance(current, list):
+        patch = []
+        for index in range(min(len(previous), len(current))):
+            patch.extend(_reference_context_patch(previous[index], current[index], path + '/' + str(index)))
+        for index in range(len(previous) - 1, len(current) - 1, -1):
+            patch.append({'op': 'remove', 'path': path + '/' + str(index)})
+        for value in current[len(previous):]:
+            patch.append({'op': 'add', 'path': path + '/-', 'value': deepcopy(value)})
+        return patch
+    if type(previous) is not type(current) or previous != current:
+        return [{'op': 'replace', 'path': path, 'value': deepcopy(current)}]
+    return []
+
