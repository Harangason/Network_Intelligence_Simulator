+def _reference_fresh_inventory_id(prepared, kind, available, existing_ids):
+    """Allocate mechanical native-choice identity, never hardware semantics."""
+    import hashlib
+    seed = json.dumps([kind, sorted(prepared['fact_id_map'][key] for key in available),
+                       sorted(existing_ids)], ensure_ascii=False, separators=(',', ':'))
+    base = 'derived-' + hashlib.sha256(seed.encode('utf8')).hexdigest()[:24]
+    candidate, suffix = base, 0
+    while candidate in existing_ids:
+        suffix += 1
+        candidate = base + '-' + str(suffix)
+    return candidate
+
