+def _reference_fresh_identity_schema(definition, existing_ids):
+    """Express finite ID exclusion with positive, native-grammar alternatives.
+
+    Each constrained branch consumes one exact string length. This avoids
+    lookahead/not keywords and end-anchor ambiguity for identifiers with LF.
+    All other lengths and every non-colliding string remain available.
+    """
+    from copy import deepcopy
+    base = deepcopy(definition)
+    minimum, maximum = base['minLength'], base.get('maxLength')
+    groups = {}
+    for value in sorted(set(existing_ids)):
+        if len(value) >= minimum and (maximum is None or len(value) <= maximum):
+            groups.setdefault(len(value), []).append(value)
+    if 'pattern' in base:
+        raise ValueError('Eine zusätzliche Identitätsregel benötigt eine ausdrückliche native Schnittmenge.')
+
+    def length_branch(lower, upper):
+        branch = {**deepcopy(base), 'minLength': lower,
+                  'pattern': r'^([^\n]|\n){' + str(lower) + ','
+                             + (str(upper) if upper is not None else '') + '}$'}
+        if upper is not None:
+            branch['maxLength'] = upper
+        return branch
+
+    if not groups:
+        return length_branch(minimum, maximum)
+
+    def escape(char, *, character_class=False):
+        if char in {'\n', '\r', '\t'}:
+            return {'\n': r'\n', '\r': r'\r', '\t': r'\t'}[char]
+        special = r'\[]-^' if character_class else r'\.^$*+?{}[]|()'
+        return '\\' + char if char in special else char
+
+    def exclusion(words, length, depth=0):
+        children = {}
+        for word in words:
+            children.setdefault(word[depth], []).append(word)
+        suffix = length - depth - 1
+        alternatives = [
+            '[^' + ''.join(escape(char, character_class=True) for char in children) + ']'
+            + (r'([^\n]|\n)' + '{' + str(suffix) + '}' if suffix else '')]
+        if suffix:
+            alternatives.extend(escape(char) + exclusion(rows, length, depth + 1)
+                                for char, rows in children.items())
+        return '(' + '|'.join(alternatives) + ')'
+
+    alternatives = []
+    lower = minimum
+    for length, words in sorted(groups.items()):
+        if lower < length:
+            alternatives.append(length_branch(lower, length - 1))
+        alternatives.append({**deepcopy(base), 'minLength': length, 'maxLength': length,
+                             'pattern': '^' + exclusion(words, length) + '$'})
+        lower = length + 1
+    if maximum is None or lower <= maximum:
+        alternatives.append(length_branch(lower, maximum))
+    return alternatives[0] if len(alternatives) == 1 else {'anyOf': alternatives}
+
+
