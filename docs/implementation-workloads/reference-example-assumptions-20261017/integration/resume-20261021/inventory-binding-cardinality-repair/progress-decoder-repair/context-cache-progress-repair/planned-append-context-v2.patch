+def _reference_context_patch(previous, current, path=''):
+    """Encode the complete private context losslessly as RFC6902 updates."""
+    from copy import deepcopy
+    if isinstance(previous, dict) and isinstance(current, dict):
+        patch = []
+        def pointer(key):
+            return path + '/' + key.replace('~', '~0').replace('/', '~1')
+        for key in previous:
+            if key not in current:
+                patch.append({'op': 'remove', 'path': pointer(key)})
+        for key, value in current.items():
+            if key not in previous:
+                patch.append({'op': 'add', 'path': pointer(key), 'value': deepcopy(value)})
+            else:
+                patch.extend(_reference_context_patch(previous[key], value, pointer(key)))
+        return patch
+    if isinstance(previous, list) and isinstance(current, list):
+        patch = []
+        for index in range(min(len(previous), len(current))):
+            patch.extend(_reference_context_patch(previous[index], current[index], path + '/' + str(index)))
+        for index in range(len(previous) - 1, len(current) - 1, -1):
+            patch.append({'op': 'remove', 'path': path + '/' + str(index)})
+        for value in current[len(previous):]:
+            patch.append({'op': 'add', 'path': path + '/-', 'value': deepcopy(value)})
+        return patch
+    if type(previous) is not type(current) or previous != current:
+        return [{'op': 'replace', 'path': path, 'value': deepcopy(current)}]
+    return []
+
+
+def _reference_context_messages(history, previous, current, system, maximum):
+    """Append exact native replies; rebase only to a complete current snapshot."""
+    import json
+    protocol = (
+        ' NIS-Kontextfortsetzung: Die erste Nutzernachricht enthält den vollständigen Planungskontext. '
+        'Nachrichten mit nis_context_patch aktualisieren diesen vollständig nach RFC6902; nicht genannte '
+        'Werte bleiben unverändert. Maßgeblich ist der daraus rekonstruierte aktuelle NIS-Kontext mit '
+        'planning_stage und output_fields_for_this_stage. Vorherige Modellantworten sind Vorschläge; '
+        'nur die NIS-Kontextupdates bestätigen den serverseitig geprüften Zwischenstand. '
+        'Keine ursprünglichen Fakten, Teilnehmer oder offenen Quellenbereiche verwerfen. '
+        'Weiter ausschließlich im aktuellen Antwortschema antworten.')
+    full = [{'role': 'system', 'content': system + protocol},
+            {'role': 'user', 'content': json.dumps(current, ensure_ascii=False, separators=(',', ':'))}]
+    if history and previous is not None:
+        appended = [*history, {'role': 'user', 'content': json.dumps(
+            {'nis_context_patch': _reference_context_patch(previous, current)},
+            ensure_ascii=False, separators=(',', ':'))}]
+        try:
+            _reference_context_window(appended, maximum)
+        except ValueError:
+            pass  # The full snapshot below must still pass the unchanged guard.
+        else:
+            return appended, full, False
+    _reference_context_window(full, maximum)
+    return full, full, bool(history)
 
 
