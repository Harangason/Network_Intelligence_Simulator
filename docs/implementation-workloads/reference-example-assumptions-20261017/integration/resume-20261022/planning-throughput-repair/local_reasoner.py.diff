+async def _reference_stream_response(client, url, payload, report):
+    """Receive actual native output; never infer tokens from a heartbeat."""
+    import asyncio
+    from contextlib import suppress
+    from time import monotonic
+    started, last_report = monotonic(), 0.0
+    chunks, received, final = [], 0, None
+
+    def progress(state):
+        nonlocal last_report
+        last_report = monotonic()
+        report({'request_state': state, 'elapsed_seconds': round(last_report - started, 1),
+                'received_characters': received})
+
+    progress('WAITING_FOR_PROVIDER')
+
+    async def pulse():
+        while True:
+            await asyncio.sleep(10)
+            if final is None:
+                progress('RECEIVING_OUTPUT' if received else 'WAITING_FOR_PROVIDER')
+
+    heartbeat = asyncio.create_task(pulse())
+    try:
+        async with client.stream('POST', url, json=payload) as response:
+            if response.is_error:
+                raise RuntimeError(f'Lokale Referenzplanung fehlgeschlagen (HTTP {response.status_code}).')
+            async for line in response.aiter_lines():
+                if not line.strip():
+                    continue
+                body = json.loads(line)
+                if body.get('error'):
+                    raise RuntimeError('Lokale Referenzplanung: ' + str(body['error']))
+                if final is not None:
+                    raise ValueError('Lokaler Qwen lieferte Daten nach seiner terminalen Antwort.')
+                content = (body.get('message') or {}).get('content', '')
+                if not isinstance(content, str):
+                    raise ValueError('Lokaler Qwen lieferte kein gültiges Antwortfragment.')
+                chunks.append(content)
+                received += len(content)
+                if body.get('done') is True:
+                    final = body
+                    progress('RECEIVED')
+                elif received and monotonic() - last_report >= 1:
+                    progress('RECEIVING_OUTPUT')
+            if final is None:
+                raise ValueError('Lokale Referenzantwort endete ohne terminale Providerbestätigung; kein Entwurf wurde übernommen.')
+    finally:
+        heartbeat.cancel()
+        with suppress(asyncio.CancelledError):
+            await heartbeat
+    return {**final, 'message': {**(final.get('message') or {}), 'content': ''.join(chunks)}}
+
