+def _reference_profile_sources(source, profiles):
+    """Keep every source interval in its nearest reviewed system or shared ancestor."""
+    from backend.nis.agent.orchestration.project_intake import document_source_contexts, document_system_scope
+    profiles = list(profiles)
+    sections = {profile: [] for profile in profiles}
+    offsets, contexts = document_source_contexts(source)
+    for start, end, context in zip(offsets, [*offsets[1:], len(source)], contexts):
+        scope = tuple(document_system_scope(context))
+        owners = [profile for profile in profiles if scope[:len(profile)] == profile]
+        if owners:
+            # A real nested system owns its descendants; an unknown section
+            # under that system is context, never an omitted source fragment.
+            targets = [max(owners, key=len)]
+        else:
+            targets = [profile for profile in profiles if profile[:len(scope)] == scope]
+        if not targets and end > start:
+            raise ValueError('Ursprünglicher Quellenabschnitt ohne eindeutigen Profilbezug: ' + repr(context))
+        for profile in targets:
+            sections[profile].append(source[start:end])
+    return {profile: ''.join(parts) for profile, parts in sections.items()}
 
 
