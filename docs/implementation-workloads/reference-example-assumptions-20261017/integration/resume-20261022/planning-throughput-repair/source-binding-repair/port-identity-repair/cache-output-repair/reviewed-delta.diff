+            stream.write(json.dumps({'at_utc': datetime.now(timezone.utc).isoformat(), **event}) + '\n')
+        if event['request_state'] == 'RECEIVING_OUTPUT' and not (OUT / (name + '-worker.json')).exists():
+            save(name + '-worker.json', workers())
