+def _reference_expand_selected_ports(ports, values, selected):
+    """Expand model parameter decisions onto unchanged ordinary NIS port intent."""
+    from copy import deepcopy
+    by_id = {row['id']: row for row in ports}
+    if (len(by_id) != len(ports) or len(set(selected)) != len(selected)
+            or not set(selected) <= set(by_id) or not isinstance(values, dict)
+            or set(values) != set(selected)):
+        raise ValueError('Portauslegung muss genau die angeforderten eindeutigen Port-IDs liefern; '
+                         'keine fehlenden, doppelten oder fremden Anschlüsse.')
+    result = []
+    for identity in selected:
+        value = values[identity]
+        if not isinstance(value, dict) or set(value) != {'parameters', 'rationale', 'field_references'}:
+            raise ValueError('Die Parameterstufe darf Portidentität, Teilnehmer, Technologie, Rolle '
+                             'oder Netzzuordnung nicht ändern. Nur Anschlussparameter liefern.')
+        result.append({**deepcopy(by_id[identity]), **deepcopy(value)})
+    return result
+
+
+def _reference_expand_selected_functions(values, selected):
+    """Bind every selected original function fact exactly once; infer no function data."""
+    from copy import deepcopy
+    from backend.nis.agent.orchestration.project_intake import ReferenceFunction
+    if (len(set(selected)) != len(selected) or not isinstance(values, dict)
+            or set(values) != set(selected)):
+        raise ValueError('Die Funktionsstufe muss genau ihre ursprünglichen Funktions-FactIDs abdecken; '
+                         'keine fehlenden, doppelten oder fremden Quellenidentitäten.')
+    mutable = set(ReferenceFunction.model_fields) - {'source_fact_id'}
+    result = []
+    for identity in selected:
+        value = values[identity]
+        if not isinstance(value, dict) or set(value) - mutable:
+            raise ValueError('Die Funktionsstufe darf ihre ursprüngliche Quellenidentität nicht überschreiben.')
+        result.append({'source_fact_id': identity, **deepcopy(value)})
+    return result
 
 
