+def native_existing_bindings(rows):
+    """Private keyed wire; never deduplicate an invalid authored identity list."""
+    assert len({row['device_id'] for row in rows}) == len(rows)
+    following = None
+    for row in reversed(rows):
+        following = {row['device_id']: {
+            **{key: value for key, value in row.items() if key not in {'choice_kind', 'device_id'}},
+            'following': following}}
+    return {'choice_kind': 'EXISTING_BATCH', 'bindings': following}
+
+
+def native_binding_records(choice):
+    """Independent reader for authored private ordered binding nodes."""
+    node, rows = choice['bindings'], []
+    while node is not None:
+        assert isinstance(node, dict) and len(node) == 1
+        identity, fields = next(iter(node.items()))
+        rows.append({'device_id': identity, **{key: value for key, value in fields.items() if key != 'following'}})
+        node = fields['following']
+    return rows
+
+
+def native_binding_schemas(schema):
+    """Inspect every explicit identity key in the private finite node grammar."""
+    records = {}
+    for name, definition in schema['$defs'].items():
+        if not name.startswith('NativeReferenceBinding_'):
+            continue
+        for node in definition['anyOf']:
+            assert node['additionalProperties'] is False
+            assert len(node['properties']) == 1 and node['required'] == list(node['properties'])
+            identity, record = next(iter(node['properties'].items()))
+            records.setdefault(identity, []).append(record)
+    return records
 
 
