+def _reference_unique(items: list[dict], field: str, label: str) -> dict:
+    result = {}
+    for item in items:
+        key = item[field]
+        if not isinstance(key, str) or not key.strip() or key in result:
+            raise ValueError(f'{label}: doppelte oder leere Identität {key!r}.')
+        result[key] = item
+    return result
