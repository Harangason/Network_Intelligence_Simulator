-def triangle_wave(t_s: float, period_s: float, minimum: int, maximum: int) -> int:
-    if period_s <= 0:
-        return minimum
-    phase = (t_s % period_s) / period_s
-    if phase < 0.5:
-        y = phase * 2.0
-    else:
-        y = (1.0 - phase) * 2.0
-    return int(minimum + y * (maximum - minimum))
