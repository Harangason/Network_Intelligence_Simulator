+def _format_tokens(value: Any) -> list[str]:
+    if isinstance(value, list):
+        raw = value
+    else:
+        raw = str(value or "universal-jsonl,universal-csv").split(",")
+    result: list[str] = []
+    for item in raw:
+        token = str(item).strip().lower()
+        if token and token not in result:
+            result.append(token)
+    return result
