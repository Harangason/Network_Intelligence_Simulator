+
+def run_simulation(config: dict[str, Any], *, validate_only: bool = False) -> dict[str, Any]:
+    return DEFAULT_SIMULATOR.run(config, validate_only=validate_only)
+
+
+def load_config(path: Path) -> dict[str, Any]:
