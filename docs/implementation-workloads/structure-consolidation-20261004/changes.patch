+        fd_bitrate=2_000_000,
+        xl_data_bitrate=None,
+        eth_bitrate=1_000_000_000,
+        eth_bitrates=None,
+        eth_messages=None,
+        simulation_mode="restbus",
+        interface_out=None,
+        config=None,
+        scenario={},
+        filter_system=None,
+        filter_summary=None,
+        hardware=None,
