+    r('ethernet_bitrate_bps',{'device_profile':'FURUNO_FAR2XX8_MK2'},allowed=[100000000],source=FAR)
+    r('datagram_bytes',maximum_parameter='iec61162_peer_datagram_limit',source=P450)
