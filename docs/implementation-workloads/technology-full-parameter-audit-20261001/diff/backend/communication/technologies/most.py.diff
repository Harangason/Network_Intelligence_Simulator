+"""MOST generation/INIC-specific clocks and resources; separate host ports and carriers."""
+P25='https://ww1.microchip.com/downloads/aemDocuments/documents/AIS/ProductDocuments/DataSheets/OS81050-Data-Sheet-DS81050AP11.pdf'
+P50='https://ww1.microchip.com/downloads/aemDocuments/documents/AIS/ProductDocuments/DataSheets/OS81092-Data-Sheet-60001271.pdf'
+P150='https://ww1.microchip.com/downloads/aemDocuments/documents/AIS/ProductDocuments/DataSheets/OS81118-Data-Sheet-60001252.pdf'
+PRODUCT='https://www.microchip.com/en-us/product/OS81118'
+SOURCES={P25:'OS81050 DS81050AP11 2003-2010 pp7-12/25/34/39/42/51-53/66; manufacturer-qualified MOST25, not full MOST normative/API specification',
+ P50:'OS81092 DS60001271B March2025 pp11-14/19-20/23/27-28/35-36/41/47-51/59/84; manufacturer-qualified MOST50, not universal host/PHY limits',
+ P150:'OS81118 DS60001252D 2018 public indexed overview/page59/78/89 excerpts only; full PDF download unavailable.384bytes/Fs48000 with47900..48100 operating range; AF/BF integrated PHY distinction; no full API or timing-table review claimed',
+ PRODUCT:'Microchip OS81118 public product description read2026-10-02; oPHY/cPHY, generation150 and actual variant-dependent features'}
+DECLARATIONS=[]
+def d(key,kind,meaning,lo=None,hi=None,unit=None,options=None,source=P25,**kw):
+    DECLARATIONS.append(dict(key='mo_'+key,type=kind,description=meaning,min=lo,max=hi,unit=unit,options=options,
+      source=source,source_revision=SOURCES[source],**kw))
+
+for key,meaning,options in [
+ ('generation','Actual MOST25/50/150 carrier generation; speed grade is not exact payload bitrate.',['MOST25','MOST50','MOST150','REGISTERED']),
+ ('device','Actual INIC/silicon/firmware-qualified profile; generations cannot share device operating limits.',['OS81050','OS81092','OS81118','REGISTERED']),
+ ('phy','Actual optical POF, MOST50 UTP electrical or qualified MOST150 coax path, not Ethernet PHY.',['OPTICAL_POF','UTP_EPHY','COAX_CPHY','REGISTERED']),
+ ('topology','Actual logical ring or qualified coax daisy-chain; physical hub needs explicit mapping.',['RING','DAISY_CHAIN','REGISTERED']),
+ ('clock_role','Actual one timing-master generates network clock; timing-slave recovers clock.',['TIMING_MASTER','TIMING_SLAVE','REGISTERED']),
+ ('channel','Actual control arbitration, async packets, synchronous allocated stream or150 iso/Ethernet channel.',['CONTROL','ASYNC_PACKET','SYNC_STREAM','ISOCHRONOUS','EMBEDDED_ETHERNET','REGISTERED']),
+ ('host_port','Actual separately configured host port; MediaLB/I2C/USB rate not network bitrate.',['I2C','MEDIALB3','MEDIALB5','MEDIALB6','STREAMING','SPI','USB','REGISTERED']),
+ ('stream_format','Actual selected stream port format/socket; device-qualified sample packing.',['I2S','LEFT_JUSTIFIED','RIGHT_JUSTIFIED','SEQUENTIAL','REGISTERED']),
+ ('variant','Actual OS81118 AF integrated coax or BF optical device variant; no assumed variant.',['AF','BF','REGISTERED']),
+ ('phy_mode','Actual dual-simplex ring versus full-duplex coax links with qualified companion.',['DUAL_SIMPLEX','FULL_DUPLEX','REGISTERED']),
+ ('message_kind','Actual MDP packet, MCM control or stream; host packet limits are not carrier frame size.',['MDP','MCM','STREAM','REGISTERED']),
+]:d(key,'select',meaning,options=options,source=P150 if key=='variant' else PRODUCT if key=='phy_mode' else P25)
+for key,meaning in [
+ ('revision','Actual hardware/product and embedded firmware revision; feature matrix requires exact device.'),
+ ('network_id','Actual canonical MOST carrier/network identity, independent application industry.'),
+ ('binding_source','Actual endpoints/generation/INIC configuration and selected physical path.'),
+ ('device_source','Actual device silicon/firmware/API/configuration-string and feature evidence.'),
+ ('clock_source','Actual frame target/calibrated recovered clock, timing-master and oscillator qualification.'),
+ ('phy_source','Actual optical front-end or cable/transformer/termination/coax/link topology qualification.'),
+ ('codec_source','Actual channel control/packet/stream complete encoding, lengths and segmentation; host PMP is not network frame.'),
+ ('allocation_source','Actual per-network shared control/packet versus granted stream bandwidth and resource mapping.'),
+ ('schedule_source','Actual arbitration/retry/processing/network-delay/lock/startup bounds and complete schedule.'),
+ ('capacity_source','Actual selected channel traffic, usable frame allocation and complete transmission schedule.'),
+ ('acceptance_source','Actual functional timing/freshness/safety/security acceptance; INIC protection not system certificate.'),
+ ('registered_source','Actual registered generation/device/host/format/physical or nonstandard timing profile.'),
+ ('host_source','Actual separate I2C/MediaLB/SPI/USB/stream interface network and codec/rate qualification.'),
+ ('mapping_source','Actual single stream source and receiver/socket/channel/resource/FBlock mapping.'),
+ ('companion_source','Actual OS81119 dual-port companion/topology qualification for daisy-chain, not arbitrary optical ring.'),
+]:d(key,'text',meaning,source=PRODUCT if key=='companion_source' else P25)
+for key,meaning,lo,hi,unit in [
+ ('frame_bytes','Actual complete carrier frame64/128/384 bytes by25/50/150; not one message payload.',1,None,'byte'),
+ ('frame_bits','Actual complete carrier bits=8*frame_bytes;25/50/150speed labels rounded.',1,None,'bit'),
+ ('timing_masters','Actual one active network timing-master; no invented master node identity.',1,1,None),
+ ('node_address','Actual configured network node address and firmware/API allocation; no default identity or unreviewed API-width cap.',0,None,None),
+ ('frame_overhead_bytes','Actual carrier framing/control overhead for selected generation/API, not generic CAN overhead.',0,None,'byte'),
+ ('control_allocation_bytes','Actual per-frame control allocation from selected device configuration.',0,None,'byte'),
+ ('stream_allocation_bytes','Actual granted synchronous/isochronous channel bytes per carrier frame.',0,None,'byte'),
+ ('packet_allocation_bytes','Actual async/Ethernet packet channel bytes per carrier frame, not packet-length limit.',0,None,'byte'),
+ ('application_bytes','Actual complete application message/stream chunk, distinct allocated carrier bytes.',0,None,'byte'),
+ ('encoded_message_bytes','Actual complete channel encoded message, may span multiple network frames.',1,None,'byte'),
+ ('fragments','Actual frames needed for async encoded message and allocation; stream/control timing separately qualified.',1,None,None),
+ ('stream_sources','Actual one granted transmitting source per synchronous streaming channel, one or more sinks.',1,1,None),
+ ('stream_sinks','Actual receivers of broadcast stream; replication does not multiply same carrier allocation.',1,None,None),
+ ('lock_sync_frames','Actual device three-frame streaming synchronization after lock, not universal transaction deadline.',0,None,'frame'),
+ ('host_clock_multiplier','Actual MediaLB/streaming port clock multiple of network Fs, independent carrierframe size.',1,None,None),
+ ('sample_bits','Actual stream sample resolution and selected port packing; meaningful bits may differ socket bytes.',1,None,'bit'),
+ ('stream_channels','Actual samples per selected port socket/frame; not network node count.',1,None,None),
+ ('stream_socket_bytes','Actual host stream socket occupancy; fits selected bitclock/frame budget.',1,None,'byte'),
+ ('host_message_bytes','Actual complete port message including 2-byte PML, distinct MOST carrier frame.',2,65537,'byte'),
+ ('pml','Actual port message length excluding its own 2-byte field.',0,65535,'byte'),
+ ('pmhl','Actual FIFO port header length excluding PML and PMHL.',1,255,'byte'),
+ ('port_body_bytes','Actual FIFO data body=PML-PMHL-1; includes function/packet metadata.',0,65533,'byte'),
+]:d(key,'number',meaning,lo,hi,unit,integer=True)
+for key,meaning,lo,hi,unit in [
+ ('target_fs_hz','Actual nominal frame target;OS81050 44100/48000 versusOS81092/OS81118 targeted48000.',1,None,'Hz'),
+ ('observed_fs_hz','Actual calibrated operating frame clock; limits depend device and lockstate.',1,None,'Hz'),
+ ('frame_period_us','Actual nominal frame interval=1e6/targetFs, not end-to-end deadline.',0,None,'us'),
+ ('oscillator_hz','Actual reference oscillator256*Fs OS81050 or384*Fs OS81092; not all generations sameclock.',1,None,'Hz'),
+ ('host_clock_hz','Actual host MediaLB/stream bitclock=multiplier*Fs, not MOST bitrate.',1,None,'Hz'),
+ ('allocation_bps','Actual selected packet allocation*8*Fs, not full carrier grossrate.',0,None,'bit/s'),
+ ('stream_start_delay_us','Actual required streaming settle time after lock=threeframes for qualified25/50devices.',0,None,'us'),
+ ('cable_impedance_ohm','Actual MOST50 UTP nominal130ohm with100..140 tolerance, not Ethernet100ohm orCAN120.',0,None,'ohm'),
+ ('temperature_c','Actual junction temperature for selected qualifieddevice, distinct ambient/storage/absolute maxima.',-273.15,None,'degC'),
+ ('core_v','Actual device core supply:25OS81050 2.5V±5percent vs50OS81092 1.8V±5percent.',0,None,'V'),
+ ('peripheral_v','Actual qualified3.3V±5percent peripheral supply; not network auxiliary12V.',0,None,'V'),
+]:d(key,'number',meaning,lo,hi,unit)
+for key,meaning in [
+ ('network_locked','Actual recovered network clock locked; unlockedstreaming not validtraffic.'),
+ ('stream_ready','Actual streaming enabled only after lock and required synchronization delay.'),
+ ('host_i2c_master','Actual OS81092 Control Port master capability only product C1D-or-later.'),
+ ('revision_c1d_or_later','Actual OS81092 product revision verified against feature matrix.'),
+]:d(key,'boolean',meaning)
+REQUIRED=['generation','device','phy','topology','clock_role','channel','revision','network_id','binding_source','device_source',
+ 'clock_source','phy_source','codec_source','allocation_source','schedule_source','capacity_source','acceptance_source']
+REMOVED={k:'MOST has no universal '+k+'; actual generation/channel/INIC allocations, arbitration and host/PHY configuration replace foreign CAN/IP policies.'
+ for k in ('queue_size','queue_policy','qos_priority','traffic_class','reserved_bandwidth_percent','sync_method','rate_limit_bit_s',
+ 'retransmission_enabled','retransmission_rate_percent','retry_limit','recovery_ms','link_fault_detect_ms','failover_ms','restore_delay_ms','mtbf_ms')}
+
+def semantics():
+    rules=[]
+    def r(key,when=None,source=P25,**kw):
+        rules.append(dict(parameter=key if key in ('bitrate_bps','payload_bytes','local_timing_evidence')else'mo_'+key,
+         when={'mo_'+k:v for k,v in(when or{}).items()},source=source,source_revision=SOURCES[source],**kw))
+    r('local_timing_evidence',allowed=[])
+    for key in ('generation','device','phy','topology','clock_role','channel','host_port','stream_format','variant','phy_mode','message_kind'):
+        r('registered_source',{key:'REGISTERED'},required=True)
+    for generation,size,source in [('MOST25',64,P25),('MOST50',128,P50),('MOST150',384,P150)]:
+        r('frame_bytes',{'generation':generation},allowed=[size],source=source)
+        r('frame_bits',{'generation':generation},allowed=[size*8],source=source)
+    for device,generation,phy,fs,source in [
+        ('OS81050','MOST25',['OPTICAL_POF'],[44100,48000],P25),
+        ('OS81092','MOST50',['UTP_EPHY'],[48000],P50),
+        ('OS81118','MOST150',['OPTICAL_POF','COAX_CPHY'],[48000],P150)]:
+        w={'device':device};r('generation',w,allowed=[generation],source=source)
+        r('phy',w,allowed=phy,source=source);r('target_fs_hz',w,allowed=fs,source=source)
+        if device in ('OS81050','OS81092'):
+            r('channel',w,forbidden=['ISOCHRONOUS','EMBEDDED_ETHERNET'],source=source)
+            r('host_port',w,allowed=['I2C','MEDIALB3','MEDIALB5','STREAMING'],source=source)
+            r('temperature_c',w,minimum=-40,maximum=125,source=source)
+            r('peripheral_v',w,minimum=3.135,maximum=3.465,source=source)
+            r('core_v',w,minimum=2.375 if device=='OS81050' else 1.71,maximum=2.625 if device=='OS81050' else 1.89,source=source)
+            r('lock_sync_frames',w,allowed=[3],source=source)
+            r('stream_start_delay_us',w,minimum_expression={'product':[3000000,{'power':['mo_target_fs_hz',-1]}]},source=source)
+            r('oscillator_hz',w,equal_expression={'product':['mo_target_fs_hz',256 if device=='OS81050' else 384]},source=source)
+            r('phy_mode',w,allowed=['DUAL_SIMPLEX'],source=source)
+            r('host_i2c_master',{'device':'OS81050'},allowed=[False])
+            for port,limit in [('I2C',50),('MEDIALB3',1014),('MEDIALB5',1014)]:
+                r('application_bytes',{'device':device,'host_port':port,'message_kind':'MDP'},maximum=limit,source=source)
+            r('host_message_bytes',w,equal_expression={'sum':['mo_pml',2]},exact_decimal_equality=True,source=source)
+            r('pml',w,minimum_expression={'sum':['mo_pmhl',1]},source=source)
+            r('port_body_bytes',w,equal_expression={'subtract':['mo_pml',{'sum':['mo_pmhl',1]}]},exact_decimal_equality=True,source=source)
+            for fmt in ('LEFT_JUSTIFIED','RIGHT_JUSTIFIED'):
+                wfmt={'device':device,'host_port':'STREAMING','stream_format':fmt}
+                r('host_clock_multiplier',wfmt,allowed=[64,128],source=source)
+                r('sample_bits',wfmt,allowed=[16,24],source=source)
+                r('stream_channels',wfmt,allowed=[1,2],source=source)
+                r('stream_channels',{**wfmt,'host_clock_multiplier':128},allowed=[2],source=source)
+                r('stream_socket_bytes',wfmt,equal_expression={'product':['mo_sample_bits','mo_stream_channels',.125]},exact_decimal_equality=True,source=source)
+            r('host_clock_multiplier',{'device':device,'host_port':'STREAMING','stream_format':'SEQUENTIAL'},
+              allowed=[64,128,256] if device=='OS81050' else [8,16,32,64,128,256],source=source)
+            r('host_clock_multiplier',{'device':device,'host_port':'STREAMING','stream_format':'I2S'},allowed=[64,128,256],source=source)
+        r('observed_fs_hz',w,minimum=44000 if device=='OS81050' else 47900,maximum=48100,source=source)
+    r('frame_bits',equal_expression={'product':['mo_frame_bytes',8]},exact_decimal_equality=True)
+    r('bitrate_bps',equal_expression={'product':['mo_frame_bits','mo_target_fs_hz']},exact_decimal_equality=True)
+    r('frame_period_us',equal_expression={'product':[1000000,{'power':['mo_target_fs_hz',-1]}]})
+    r('payload_bytes',equal_parameter='mo_application_bytes')
+    r('encoded_message_bytes',minimum_parameter='mo_application_bytes')
+    r('frame_bytes',when_present=['mo_frame_bits'],required=True)
+    r('target_fs_hz',when_present=['mo_frame_period_us'],required=True)
+    for key in ('frame_bits','target_fs_hz'):r(key,required=True)
+    r('frame_bytes',equal_expression={'sum':['mo_frame_overhead_bytes','mo_control_allocation_bytes','mo_stream_allocation_bytes','mo_packet_allocation_bytes']},exact_decimal_equality=True)
+    for key in ('frame_overhead_bytes','control_allocation_bytes','stream_allocation_bytes','packet_allocation_bytes'):
+        r(key,maximum_parameter='mo_frame_bytes')
+    r('allocation_bps',equal_expression={'product':['mo_packet_allocation_bytes',8,'mo_target_fs_hz']},exact_decimal_equality=True)
+    r('fragments',{'channel':'ASYNC_PACKET'},when_positive=['mo_packet_allocation_bytes'],
+      equal_expression={'ceiling':[{'product':['mo_encoded_message_bytes',{'power':['mo_packet_allocation_bytes',-1]}]}]},exact_decimal_equality=True)
+    r('encoded_message_bytes',when_present=['mo_fragments'],required=True)
+    r('packet_allocation_bytes',when_present=['mo_fragments'],required=True,minimum=1)
+    r('network_locked',{'stream_ready':True},allowed=[True],required=True)
+    r('stream_start_delay_us',{'stream_ready':True},required=True)
+    for key in ('mapping_source','stream_sources','stream_sinks'):r(key,{'channel':'SYNC_STREAM'},required=True)
+    r('host_source',when_present=['mo_host_port'],required=True)
+    r('host_clock_hz',equal_expression={'product':['mo_host_clock_multiplier','mo_target_fs_hz']})
+    for device in ('OS81050','OS81092'):
+        for port,values in [('MEDIALB3',[256,512,1024]),('MEDIALB5',[256,512])]:
+            r('host_clock_multiplier',{'device':device,'host_port':port},allowed=values,source=P25 if device=='OS81050'else P50)
+    r('stream_socket_bytes',{'host_port':'STREAMING'},maximum_expression={'product':['mo_host_clock_multiplier',.125]})
+    r('host_clock_multiplier',{'host_port':'STREAMING'},when_present=['mo_stream_socket_bytes'],required=True)
+    r('revision_c1d_or_later',{'device':'OS81092','host_i2c_master':True},allowed=[True],required=True,source=P50)
+    r('cable_impedance_ohm',{'device':'OS81092','phy':'UTP_EPHY'},minimum=100,maximum=140,source=P50)
+    r('topology',{'device':'OS81050'},allowed=['RING','REGISTERED'])
+    r('topology',{'device':'OS81092'},allowed=['RING','REGISTERED'],source=P50)
+    r('variant',{'device':'OS81118'},required=True,source=P150)
+    r('phy',{'device':'OS81118','variant':'BF'},allowed=['OPTICAL_POF'],source=P150)
+    r('phy_mode',{'device':'OS81118','phy':'OPTICAL_POF'},allowed=['DUAL_SIMPLEX'],source=PRODUCT)
+    r('phy',{'topology':'DAISY_CHAIN'},allowed=['COAX_CPHY'],source=PRODUCT)
+    r('generation',{'topology':'DAISY_CHAIN'},allowed=['MOST150'],source=PRODUCT)
+    r('phy_mode',{'topology':'DAISY_CHAIN'},allowed=['FULL_DUPLEX'],required=True,source=PRODUCT)
+    r('companion_source',{'topology':'DAISY_CHAIN'},required=True,source=PRODUCT)
+    return dict(rate_model={'type':'SINGLE_BITRATE','fields':['bitrate_bps'],'minimum_bps':1},
+      required_parameters=['bitrate_bps',*['mo_'+k for k in REQUIRED]],native_parameter_prefixes=['mo_'],
+      parameter_evidence_scope='EXPLICIT_LAYER',parameter_constraints=rules,
+      mechanisms={'clocking':['GENERATION_FRAME_BITS_TIMES_SELECTED_FS','ONE_TIMING_MASTER'],
+       'channel':['SEPARATE_CONTROL_PACKET_GRANTED_STREAM','HOST_MEDIALB_I2C_SPI_USB_NOT_CARRIER'],
+       'physical':['EXPLICIT_GENERATION_DEVICE_OPTICAL_UTP_COAX']})
+
+def fields():
+    result=[]
+    for spec in DECLARATIONS:
+        key=spec['key'][3:];item={k:v for k,v in spec.items()if v is not None}
+        item.update(label=key.replace('_',' '),category='physical',scope='network',editable=True,required=key in REQUIRED,
+          parameter_origin='DEVICE_CONFIGURATION',default_status='UNKNOWN',validation_relevant=True,simulation_relevant=False)
+        conditional=[]
+        if key in ('frame_bytes','frame_bits'):
+            for gen,n,src in [('MOST25',64,P25),('MOST50',128,P50),('MOST150',384,P150)]:
+                conditional.append(dict(when={'mo_generation':gen},value=n*(8 if key=='frame_bits' else 1),source=src,source_revision=SOURCES[src]))
+        if key=='target_fs_hz':
+            for device,fs,src in [('OS81050',44100,P25),('OS81092',48000,P50),('OS81118',48000,P150)]:
+                conditional.append(dict(when={'mo_device':device},value=fs,source=src,source_revision=SOURCES[src]))
+        if key=='lock_sync_frames':
+            conditional=[dict(when={'mo_device':device},value=3,source=src,source_revision=SOURCES[src])for device,src in [('OS81050',P25),('OS81092',P50)]]
+        if key=='cable_impedance_ohm':conditional=[dict(when={'mo_device':'OS81092','mo_phy':'UTP_EPHY'},value=130,source=P50,source_revision=SOURCES[P50])]
+        if conditional:item.update(default_status='PROPOSED_CONDITIONAL',conditional_defaults=conditional)
+        result.append(item)
+    return result
