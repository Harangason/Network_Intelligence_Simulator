+def test_schema_scope_alternatives_match_exact_types_and_never_silently_borrow_bounds():
+    registry=TechnologyRegistry()
+    registry.register_defaults([profile(parameter_schema={
+        'value':{'type':'number','min':0,'max':10,'schema_when':{'version':['A','B'],'aux_enabled':[False]}}})])
+    for version in ('A','B'):
+        assert registry.validate_parameters('test_bus',{'value':10,'version':version,'aux_enabled':False})['status']=='VALID'
+        assert registry.validate_parameters('test_bus',{'value':11,'version':version,'aux_enabled':False})['status']=='INVALID'
+    for version,enabled in [('A',0),('C',False),('A',True)]:
+        assert registry.validate_parameters('test_bus',{'value':10,'version':version,'aux_enabled':enabled})['status']=='UNVERIFIED'
+
