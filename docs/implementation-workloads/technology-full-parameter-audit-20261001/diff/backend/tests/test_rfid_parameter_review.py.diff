+ for k in('tag_id','region_id','device_source','crc_valid','data_accepted','frame_source'):
+  f=next(v for v in registry.parameter_fields('rfid')if v['key']=='rfid_'+k);assert 'default'not in f and 'conditional_defaults'not in f
+ assert not x.get('rfid_data_accepted')and'bitrate'not in x
