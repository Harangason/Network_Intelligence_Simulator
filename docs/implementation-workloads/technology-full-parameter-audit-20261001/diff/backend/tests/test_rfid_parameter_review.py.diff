+def actual(profile=P.UHF):
+ return {**{'rfid_'+k:'synthetic-'+k for k in P.REQUIRED},'rfid_profile':profile,'rfid_role':'READER'}
+def status(x):return registry.validate_parameters('rfid',x)['status']
+def proposal(profile,configuration):
+ x={**actual(profile),'rfid_configuration':configuration}
+ for f in registry.parameter_fields('rfid'):
+  for d in f.get('conditional_defaults',[]):
+   if all(x.get(k)==v for k,v in d['when'].items()):x[f['key']]=d['value']
+ return x
+def test_rfid_umbrella_has_no_own_bitrate_can_queue_255payload_or_capacity_certificate():
+ p=registry.profile('rfid');assert p['rate_model']['fields']==[]and p['max_payload_bytes']is None
+ assert p['capacity_evidence']['status']=='MODEL_MISSING'and status(actual())=='VALID'
+ f=registry.parameter_fields('rfid');assert len(f)==len({v['key']for v in f})and not set(P.REMOVED)&{v['key']for v in f}
+ assert status({})=='UNVERIFIED'
+ for bad in({'bitrate_bps':500000},{'nominal_bitrate_bps':500000},{'mtu_bytes':1500},{'local_timing_evidence':{'confirmed':True}}):assert status({**actual(),**bad})=='INVALID'
+ assert status({**actual(),'payload_bytes':2000})=='VALID'
+@pytest.mark.parametrize('field',registry.parameter_fields('rfid'),ids=lambda f:f['key'])
+def test_rfid_every_exported_field_type_and_outer_bounds(field):
+ base=actual({P.HF:P.HFP,P.LF:P.LFP}.get(field.get('source'),P.UHF))
+ k=field['key'];assert status({**base,k:'wrong'if field['type']=='number'else 1})=='INVALID'
+ for edge,delta in [('min',-1),('max',1)]:
+  if field.get(edge)is not None:assert status({**base,k:field[edge]+delta})=='INVALID'
+@pytest.mark.parametrize('profile',[P.UHF,P.HFP,P.LFP])
+def test_rfid_individual_profile_defaults_are_valid_proposals_not_actual_evidence(profile):
