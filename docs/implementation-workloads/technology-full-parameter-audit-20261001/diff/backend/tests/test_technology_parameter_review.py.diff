+@pytest.mark.parametrize('values,code', [
+    ({'bitrate': 2_000_000}, 'TECHNOLOGY_PARAMETER_OUT_OF_RANGE'),
+    ({'bitrate': 19200, 'data_bitrate': 2_000_000}, 'TECHNOLOGY_RATE_MODEL_MISMATCH'),
