+    assert result['bitrate'] == 250_000 and result['bitrate_bps'] == 500_000
+    assert not result['_rate_evidenced']
+    assert any(item['code'] == 'TECHNOLOGY_PARAMETER_CONFLICT' for item in result['_rate_findings'])
+
