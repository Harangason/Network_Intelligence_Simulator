+.trace-chart-axis { stroke: var(--muted); }
+.trace-trend-point[aria-disabled="false"] { cursor: pointer; }
+.trace-trend-point:focus-visible { outline: 2px solid var(--accent); }
+.trace-trend-point:focus-visible circle:last-child { stroke: var(--text); stroke-width: 2; }
+.trace-chart-series { display: flex; flex-wrap: wrap; gap: 12px; color: var(--muted); font-size: 10px; }
+.trace-chart-series span { display: flex; align-items: center; gap: 6px; }
+.trace-chart-series i { width: 16px; height: 3px; }
+.trace-chart-card details { color: var(--text); font-size: 11px; }
+.trace-chart-card summary { margin-bottom: 10px; cursor: pointer; }
+.trace-chart-table-scroll { min-width: 0; max-height: 430px; overflow: auto; }
+.trace-chart-table-scroll table { width: 100%; border-collapse: collapse; font-size: 10px; }
+.trace-chart-table-scroll th, .trace-chart-table-scroll td { padding: 9px 8px; border-bottom: 1px solid var(--border); color: var(--text); text-align: left; vertical-align: top; overflow-wrap: anywhere; }
+.trace-chart-table-scroll th { font-weight: 500; }
+.trace-chart-table-scroll thead { position: sticky; top: 0; z-index: 1; background: var(--surface); }
+.trace-chart-table-scroll small { display: block; margin-top: 4px; color: var(--muted); font-size: 9px; }
+.trace-frequency-matrix { min-width: 680px; }
+.trace-frequency-matrix th:first-child { min-width: 180px; max-width: 280px; }
+.trace-frequency-matrix thead th:not(:first-child) { min-width: 75px; text-align: center; white-space: nowrap; }
+.trace-frequency-matrix td { padding: 3px; vertical-align: middle; }
+.trace-frequency-matrix button { min-height: 34px; width: 100%; padding: 6px; border: 0; border-radius: 3px; color: var(--text); background: transparent; text-align: left; cursor: pointer; font: inherit; }
+.trace-frequency-matrix td button { text-align: center; background: color-mix(in srgb, var(--warning) var(--trace-heat, 0%), var(--surface)); font-family: var(--font-geist-mono), monospace; }
+.trace-frequency-matrix td button:disabled { opacity: .6; cursor: default; }
+.trace-chart-evidence { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--border); min-width: 0; }
+.trace-chart-evidence > .panel-heading { flex-wrap: wrap; gap: 10px; }
+.trace-chart-evidence > p { color: var(--muted); font-size: 11px; line-height: 1.7; }
+.trace-chart-evidence table { min-width: 650px; }
+.trace-chart-selected { box-shadow: inset 3px 0 var(--accent); }
+.trace-chart-event-actions { display: flex; flex-wrap: wrap; gap: 5px; }
+.trace-chart-original { margin: 14px 0; color: var(--text); font-size: 11px; }
+.trace-chart-original summary { cursor: pointer; overflow-wrap: anywhere; }
+.trace-chart-original pre { max-height: 320px; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; }
 
