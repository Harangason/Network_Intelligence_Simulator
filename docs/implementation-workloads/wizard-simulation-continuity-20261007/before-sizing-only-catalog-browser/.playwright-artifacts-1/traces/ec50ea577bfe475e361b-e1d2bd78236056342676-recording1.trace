e\\\",\\\"FrontRightUltrasonicDistance\\\",\\\"RearLeftUltrasonicDistance\\\",\\\"RearRightUltrasonicDistance\\\",\\\"UltraschallverarbeitungHealthFeedback\\\",\\\"UltraschallverarbeitungOperatingState\\\",\\\"UltraschallverarbeitungPrimaryFeedback\\\"],\\\"actuators\\\":[\\\"UltraschallverarbeitungEnableCommand\\\",\\\"UltraschallverarbeitungPrimaryCommand\\\",\\\"UltraschallverarbeitungSafetyCommand\\\",\\\"UltraschallverarbeitungSchaltausgang\\\",\\\"UltraschallverarbeitungStellglied\\\"]}],\\\"unassigned\\\":[],\\\"hmi_routes\\\":[{\\\"source\\\":\\\"Drehmomentkoordination\\\",\\\"target\\\":\\\"Kombiinstrument\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"DrehmomentkoordinationStatus\\\"],\\\"path\\\":[\\\"Drehmomentkoordination\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"Kombiinstrument\\\"]},{\\\"source\\\":\\\"Drehmomentkoordination\\\",\\\"target\\\":\\\"Infotainment\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"DrehmomentkoordinationStatus\\\"],\\\"path\\\":[\\\"Drehmomentkoordination\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"Infotainment\\\"]},{\\\"source\\\":\\\"Drehmomentkoordination\\\",\\\"target\\\":\\\"HeadUpDisplay\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"DrehmomentkoordinationStatus\\\"],\\\"path\\\":[\\\"Drehmomentkoordination\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"HeadUpDisplay\\\"]},{\\\"source\\\":\\\"Kameraverarbeitung\\\",\\\"target\\\":\\\"Kombiinstrument\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"KameraverarbeitungStatus\\\"],\\\"path\\\":[\\\"Kameraverarbeitung\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"Kombiinstrument\\\"]},{\\\"source\\\":\\\"Kameraverarbeitung\\\",\\\"target\\\":\\\"Infotainment\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"KameraverarbeitungStatus\\\"],\\\"path\\\":[\\\"Kameraverarbeitung\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"Infotainment\\\"]},{\\\"source\\\":\\\"Kameraverarbeitung\\\",\\\"target\\\":\\\"HeadUpDisplay\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"KameraverarbeitungStatus\\\"],\\\"path\\\":[\\\"Kameraverarbeitung\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"HeadUpDisplay\\\"]},{\\\"source\\\":\\\"Parkassistenz\\\",\\\"target\\\":\\\"Kombiinstrument\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"ParkassistenzStatus\\\"],\\\"path\\\":[\\\"Parkassistenz\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"Kombiinstrument\\\"]},{\\\"source\\\":\\\"Parkassistenz\\\",\\\"target\\\":\\\"Infotainment\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"ParkassistenzStatus\\\"],\\\"path\\\":[\\\"Parkassistenz\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"Infotainment\\\"]},{\\\"source\\\":\\\"Parkassistenz\\\",\\\"target\\\":\\\"HeadUpDisplay\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"ParkassistenzStatus\\\"],\\\"path\\\":[\\\"Parkassistenz\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"HeadUpDisplay\\\"]},{\\\"source\\\":\\\"Radarverarbeitung\\\",\\\"target\\\":\\\"Kombiinstrument\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"RadarverarbeitungStatus\\\"],\\\"path\\\":[\\\"Radarverarbeitung\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"Kombiinstrument\\\"]},{\\\"source\\\":\\\"Radarverarbeitung\\\",\\\"target\\\":\\\"Infotainment\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"RadarverarbeitungStatus\\\"],\\\"path\\\":[\\\"Radarverarbeitung\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"Infotainment\\\"]},{\\\"source\\\":\\\"Radarverarbeitung\\\",\\\"target\\\":\\\"HeadUpDisplay\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"RadarverarbeitungStatus\\\"],\\\"path\\\":[\\\"Radarverarbeitung\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"HeadUpDisplay\\\"]},{\\\"source\\\":\\\"Stabilitaetsregelung\\\",\\\"target\\\":\\\"Kombiinstrument\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"StabilitaetsregelungStatus\\\"],\\\"path\\\":[\\\"Stabilitaetsregelung\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"Kombiinstrument\\\"]},{\\\"source\\\":\\\"Stabilitaetsregelung\\\",\\\"target\\\":\\\"Infotainment\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"StabilitaetsregelungStatus\\\"],\\\"path\\\":[\\\"Stabilitaetsregelung\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"Infotainment\\\"]},{\\\"source\\\":\\\"Stabilitaetsregelung\\\",\\\"target\\\":\\\"HeadUpDisplay\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"StabilitaetsregelungStatus\\\"],\\\"path\\\":[\\\"Stabilitaetsregelung\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"HeadUpDisplay\\\"]},{\\\"source\\\":\\\"Thermomanagement\\\",\\\"target\\\":\\\"Kombiinstrument\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"ThermomanagementStatus\\\"],\\\"path\\\":[\\\"Thermomanagement\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"Kombiinstrument\\\"]},{\\\"source\\\":\\\"Thermomanagement\\\",\\\"target\\\":\\\"Infotainment\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"ThermomanagementStatus\\\"],\\\"path\\\":[\\\"Thermomanagement\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"Infotainment\\\"]},{\\\"source\\\":\\\"Thermomanagement\\\",\\\"target\\\":\\\"HeadUpDisplay\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"ThermomanagementStatus\\\"],\\\"path\\\":[\\\"Thermomanagement\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"HeadUpDisplay\\\"]},{\\\"source\\\":\\\"Ultraschallverarbeitung\\\",\\\"target\\\":\\\"Kombiinstrument\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"UltraschallverarbeitungStatus\\\"],\\\"path\\\":[\\\"Ultraschallverarbeitung\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"Kombiinstrument\\\"]},{\\\"source\\\":\\\"Ultraschallverarbeitung\\\",\\\"target\\\":\\\"Infotainment\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"UltraschallverarbeitungStatus\\\"],\\\"path\\\":[\\\"Ultraschallverarbeitung\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"Infotainment\\\"]},{\\\"source\\\":\\\"Ultraschallverarbeitung\\\",\\\"target\\\":\\\"HeadUpDisplay\\\",\\\"signals\\\":[],\\\"excluded_signals\\\":[\\\"UltraschallverarbeitungStatus\\\"],\\\"path\\\":[\\\"Ultraschallverarbeitung\\\",\\\"Ethernet\\\",\\\"Gateway\\\",\\\"HeadUpDisplay\\\"]}],\\\"warnings\\\":[]}]\\r\\n- Topologie-Cluster-Profil: automotive\\r\\n- Topologie-Cluster-Regeln: Motor / Antrieb: powertrain_exhaust, powertrain_transmission, emobility, energy; Abgasnachbehandlung: powertrain_motor, powertrain_transmission; Getriebe: powertrain_motor, emobility; E-Mobilitaet: powertrain_motor, powertrain_transmission, energy; Energie / HV: emobility, powertrain_motor, body_comfort; Fahrdynamik: driver_assistance, powertrain_motor; Passive Sicherheit: chassis, diagnostics; Fahrerassistenz: chassis, body_comfort; Karosserie / Komfort: energy, lighting, climate; Klima / Thermik: energy, body_comfort, emobility; Licht: body_comfort, energy; Infotainment: body_comfort, diagnostics; Diagnose: powertrain_motor, energy, infotainment; Regelung: sensorics, actuation, diagnostics\\r\\n- Gelernte Topologie-Nachbarschaften: noch keine Projektkorrekturen gelernt\\r\\n- RAG-Controller-Zuordnungen: 500 wiederverwendet aus 9 Projekt(en)\\r\\n- Netzarchitektur-ID: gateway_ecu_segments\\r\\n- Netzarchitektur: Variante 4 · Gateway-Segmente\\r\\n- Netzarchitektur-Regeln: Segmentierte Gateway-Backbone-Architektur: Sensoren und Aktoren werden fachlich an Controller geführt; pro Gateway-Leitung werden Controller entsprechend der einstellbaren Bus-Teilnehmergrenze als Bussegment gebündelt (Gateway mitgezählt). Das Gateway kennt die Controller-Segmente, legt aber keine Sensor-/Aktor-Direktanbindungen an.\\r\\n- Netzarchitektur-Freigabe: gemeinsam mit dem Engineering-Auftrag durch den Nutzer bestätigt am 2026-09-14T05:36:20.685Z\\r\\n- Hardware-Sollwerte: {\\\"gateways\\\":1,\\\"ecus\\\":50,\\\"sensors\\\":250,\\\"actuators\\\":250}\\r\\n- Vollstaendigkeitsprinzip: System- und Funktionsvollstaendigkeit hat Vorrang vor den Hardware-Sollwerten; diese sind Mindestumfang, keine Obergrenze. Fehlende Low-Level-Klassen, Sensoren, Aktoren und Signale fuer ausgewaehlte Systeme muessen fachlich ergaenzt werden.\\r\\n- Parameter: Technologie-Defaults verwenden\\r\\n- Workflowumfang: Workflow 1 Engineering-Modell: HardwareNodes, Functions, Interfaces, Messages, Signals und Relations anlegen; Workflow 2 Routing-Tabelle: Kommunikationspfade mit Producer, Consumer, Payload, Signal, Gateway, Protokoll und Pfad erstellen; Workflow 3 Netzwerk-Editor: physische Topologie, Ports, Verbindungen und Gateway-Uebergaenge erzeugen; Workflow 4 Parameter: technologieabhaengige Bitrate, Payload, Zyklus, Latenz, Jitter, Queueing und Safety-Defaults setzen; Workflow 5 Capacity & Timing: Last, Reserve, Gateway-Load, E2E-Latenz, Bottlenecks und Timing berechnen; Workflow 6 Validation/Preflight: Konsistenz, fehlende Interfaces, Payloads, Duplikate und Blocker pruefen; Workflow 7 Simulation: Simulationssnapshot nach aktuellem erfolgreichem Preflight anlegen; Workflow 8 Results/Analysis: Simulationsergebnisse, Artefakte, Nachweise und Ergebnisvergleich auswerten; Workflow 9 Data Science & Intelligence: Systembewertung, Reifegrad, Issues, Anomalien und Optimierungsvorschlaege erzeugen\\r\\n- Arbeitsweise: Leere Pflichtfelder mit technologieabhängigen Defaults füllen; Selbstständig bis zum Human-Review-Gate arbeiten; Nach einer menschlichen Freigabe valide Vorschläge direkt übernehmen\\r\\n\\r\\nKonkrete Aufgabe des Nutzers, per Wizard-Uebernehmen bestaetigt:\\r\\nAufgabe wurde als Datei uebergeben.\\r\\n\\r\\nAufgaben-Anlagen:\\r\\n- Aufgaben-Anlage: neu 9.txt (text/plain, 11 KB): Textinhalt als Aufgabenquelle fuer Umfang, Anforderungen und technische Vorgaben auswerten.\\r\\nMusterprojekt – Fahrzeugnetzwerk\\r\\r\\n\\r\\r\\n## 1. Systemumfang\\r\\r\\n\\r\\r\\n- **100 Sensoren**\\r\\r\\n- **100 Aktuatoren**\\r\\r\\n- **50 Funktions-ECUs**\\r\\r\\n- **1 zentrales Gateway**\\r\\r\\n- Kommunikationssysteme:\\r\\r\\n  - **25 LIN**\\r\\r\\n  - **10 CAN-FD**\\r\\r\\n  - **5 Automotive Ethernet**\\r\\r\\n- **je Funktion-ECU min 5 und max 20 Signale anlegen, die Anzahl richtet sich an die Notwendigkeit zur Darstellung der Funktionsrelevantendaten   \\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 2. Sensoren\\r\\r\\n\\r\\r\\nDie 100 Sensoren erfassen typische fahrzeugrelevante Größen, zum Beispiel:\\r\\r\\n\\r\\r\\n- Temperatur\\r\\r\\n- Druck\\r\\r\\n- Drehzahl\\r\\r\\n- Raddrehzahl\\r\\r\\n- Beschleunigung\\r\\r\\n- Lenkwinkel\\r\\r\\n- Spannung\\r\\r\\n- Strom\\r\\r\\n- Füllstand\\r\\r\\n- Position\\r\\r\\n- Abstand\\r\\r\\n- Zustände\\r\\r\\n- weitere physikalische Messgrößen\\r\\r\\n\\r\\r\\nJeder Sensor erhält mindestens:\\r\\r\\n\\r\\r\\n- eindeutige ID\\r\\r\\n- Name\\r\\r\\n- Beschreibung\\r\\r\\n- Messgröße\\r\\r\\n- Einheit\\r\\r\\n- Minimum\\r\\r\\n- Maximum\\r\\r\\n- Auflösung\\r\\r\\n- Zykluszeit\\r\\r\\n- Producer-Zuordnung\\r\\r\\n- angeschlossenes Interface\\r\\r\\n- verwendete Kommunikationstechnologie\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 3. Beispiel Temperatursensor\\r\\r\\n\\r\\r\\n- Bereich: **−20 °C bis +120 °C**\\r\\r\\n- Auflösung: **0,1 °C**\\r\\r\\n- Signal: `Temperature`\\r\\r\\n- Verwendung durch eine Thermal-/Klima-ECU\\r\\r\\n\\r\\r\\nDie ECU verarbeitet daraus beispielsweise:\\r\\r\\n\\r\\r\\n- `TemperatureCurrent`\\r\\r\\n- `TemperatureTarget`\\r\\r\\n- `TemperatureStatus`\\r\\r\\n- `OverTemperatureWarning`\\r\\r\\n- `ThermalControlRequest`\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 4. Beispiel Drehzahlsensor\\r\\r\\n\\r\\r\\n- Bereich: **0 bis 5000 U/min**\\r\\r\\n- Auflösung: **50 U/min**\\r\\r\\n- Signal: `MotorRPM`\\r\\r\\n\\r\\r\\nMögliche Werte:\\r\\r\\n\\r\\r\\n- 0\\r\\r\\n- 50\\r\\r\\n- 100\\r\\r\\n- 150\\r\\r\\n- …\\r\\r\\n- 4900\\r\\r\\n- 4950\\r\\r\\n- 5000 U/min\\r\\r\\n\\r\\r\\nBeispielregeln:\\r\\r\\n\\r\\r\\n- ab 4800 U/min → Warning\\r\\r\\n- über 5000 U/min → Grenzwertverletzung\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 5. Beispiel Stromsensor\\r\\r\\n\\r\\r\\n- Bereich: **0 bis 20 A**\\r\\r\\n- Auflösung beispielsweise: **0,1 A**\\r\\r\\n\\r\\r\\nVerwendung:\\r\\r\\n\\r\\r\\n- Motorstromüberwachung\\r\\r\\n- Lastbewertung\\r\\r\\n- Plausibilitätsprüfung\\r\\r\\n- Fehlererkennung\\r\\r\\n\\r\\r\\nBeispiel:\\r\\r\\n\\r\\r\\n```text\\r\\r\\nMotorCurrent > 5 A\\r\\r\\nAND\\r\\r\\nMotorRPM = 0\\r\\r\\n\\r\\r\\n→ MOTOR_BLOCKED_POSSIBLE\\r\\r\\n```\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 6. 50 Funktions-ECUs\\r\\r\\n\\r\\r\\nDie 50 ECUs sollen typische Fahrzeugfunktionen repräsentieren, zum Beispiel:\\r\\r\\n\\r\\r\\n- Motorsteuergerät\\r\\r\\n- Getriebesteuergerät\\r\\r\\n- Batteriemanagement\\r\\r\\n- Bremsregelsystem\\r\\r\\n- Lenkungssteuergerät\\r\\r\\n- Fahrwerksteuergerät\\r\\r\\n- Klimasteuergerät\\r\\r\\n- Body Control Module\\r\\r\\n- Türsteuergeräte\\r\\r\\n- Sitzsteuergeräte\\r\\r\\n- Lichtsteuergerät\\r\\r\\n- Airbagsteuergerät\\r\\r\\n- Kombiinstrument\\r\\r\\n- Infotainment\\r\\r\\n- Telematik\\r\\r\\n- Diagnose\\r\\r\\n- Fahrerassistenz\\r\\r\\n- Energieversorgung\\r\\r\\n- zentrale Fahrzeugsteuerung\\r\\r\\n- weitere typische Funktions-ECUs\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 7. ECU-Signale\\r\\r\\n\\r\\r\\nJede Funktionen erhält fachlich passende Nachrichten darin enthalten sind die Signale, ergänze die entsprechend der Funktionsanforderung-/beschreibung:\\r\\r\\n\\r\\r\\n\\r\\r\\n### Eingangssignale\\r\\r\\n\\r\\r\\nBeispielsweise:\\r\\r\\n\\r\\r\\n- Sensorsignale\\r\\r\\n- Statussignale anderer ECUs\\r\\r\\n- Anforderungssignale\\r\\r\\n- Diagnoseinformationen\\r\\r\\n- Netzwerkstatus\\r\\r\\n\\r\\r\\n### Ausgangssignale\\r\\r\\n\\r\\r\\nBeispielsweise:\\r\\r\\n\\r\\r\\n- Funktionsstatus\\r\\r\\n- Regelwerte\\r\\r\\n- Commands\\r\\r\\n- Warnungen\\r\\r\\n- Fehlerstatus\\r\\r\\n- Diagnosewerte\\r\\r\\n- Freigaben\\r\\r\\n- Systemzustände\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 8. Beispiel Batteriemanagement\\r\\r\\n\\r\\r\\nEingänge:\\r\\r\\n\\r\\r\\n- Zellspannungen\\r\\r\\n- Batteriestrom\\r\\r\\n- Batterietemperaturen\\r\\r\\n- Fahrzeugzustand\\r\\r\\n- Ladezustand\\r\\r\\n\\r\\r\\nAusgänge:\\r\\r\\n\\r\\r\\n- State of Charge\\r\\r\\n- State of Health\\r\\r\\n- Leistungsgrenze\\r\\r\\n- Ladefreigabe\\r\\r\\n- Entladefreigabe\\r\\r\\n- Battery Status\\r\\r\\n- Fault Level\\r\\r\\n- Temperature Warning\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 9. Beispiel Motion-/Antriebs-ECU\\r\\r\\n\\r\\r\\nEingänge:\\r\\r\\n\\r\\r\\n- Motordrehzahl\\r\\r\\n- Motorstrom\\r\\r\\n- Drehmomentanforderung\\r\\r\\n- Betriebszustand\\r\\r\\n- Fahrzustand\\r\\r\\n\\r\\r\\nAusgänge:\\r\\r\\n\\r\\r\\n- RPM Status\\r\\r\\n- Torque Status\\r\\r\\n- Motion System Status\\r\\r\\n- Limit Warning\\r\\r\\n- Drive Command\\r\\r\\n- Fault Status\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 10. Kommunikationstechnologien\\r\\r\\n\\r\\r\\n### LIN\\r\\r\\n\\r\\r\\nVerwendung für:\\r\\r\\n\\r\\r\\n- sensornahe Teilnehmer\\r\\r\\n- einfache Aktuatoren\\r\\r\\n- Komfortfunktionen\\r\\r\\n- kostengünstige Kommunikation\\r\\r\\n- weniger zeitkritische Daten\\r\\r\\n\\r\\r\\n### CAN-FD\\r\\r\\n\\r\\r\\nVerwendung für:\\r\\r\\n\\r\\r\\n- klassische Fahrzeugfunktionen\\r\\r\\n- Antrieb\\r\\r\\n- Fahrwerk\\r\\r\\n- Bremse\\r\\r\\n- Body-Funktionen\\r\\r\\n- zeitkritische Steuergeräte\\r\\r\\n\\r\\r\\n### Automotive Ethernet\\r\\r\\n\\r\\r\\nVerwendung für:\\r\\r\\n\\r\\r\\n- zentrale Steuergeräte\\r\\r\\n- Fahrerassistenz\\r\\r\\n- datenintensive Kommunikation\\r\\r\\n- Diagnose\\r\\r\\n- Infotainment\\r\\r\\n- Backbone-Kommunikation\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 11. Zentrales Gateway\\r\\r\\n\\r\\r\\nEs existiert **genau ein zentrales Gateway**.\\r\\r\\n\\r\\r\\nAufgaben:\\r\\r\\n\\r\\r\\n- Verbindung der LIN-, CAN-FD- und Ethernet-Segmente\\r\\r\\n- Routing\\r\\r\\n- Message Forwarding\\r\\r\\n- Signalweiterleitung\\r\\r\\n- Protokollübergänge\\r\\r\\n- Gateway Queueing\\r\\r\\n- Gateway Timing\\r\\r\\n- Gateway Load Monitoring\\r\\r\\n\\r\\r\\nDas Gateway muss technisch nachvollziehbar zeigen:\\r\\r\\n\\r\\r\\n- welche Messages es passieren,\\r\\r\\n- welche Signale weitergeleitet werden,\\r\\r\\n- welche Bussegmente beteiligt sind,\\r\\r\\n- welche Verzögerung entsteht,\\r\\r\\n- welche Last erzeugt wird.\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 12. Routing-Tabelle\\r\\r\\n\\r\\r\\nFür jede relevante Kommunikation wird definiert:\\r\\r\\n\\r\\r\\n- Producer\\r\\r\\n- Consumer\\r\\r\\n- Signal\\r\\r\\n- Message\\r\\r\\n- Source Interface\\r\\r\\n- Source Network\\r\\r\\n- Gateway\\r\\r\\n- Destination Network\\r\\r\\n- Destination Interface\\r\\r\\n- Routingpfad\\r\\r\\n- Zykluszeit\\r\\r\\n- Priorität\\r\\r\\n- Timing-Anforderung\\r\\r\\n\\r\\r\\nBeispiel:\\r\\r\\n\\r\\r\\n```text\\r\\r\\nECU_A\\r\\r\\n→ CAN_FD_1\\r\\r\\n→ Central Gateway\\r\\r\\n→ Ethernet Backbone\\r\\r\\n→ ECU_B\\r\\r\\n```\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 13. Routing-Erstellung\\r\\r\\n\\r\\r\\nRouting kann entstehen durch:\\r\\r\\n\\r\\r\\n- manuelle Erstellung\\r\\r\\n- Import\\r\\r\\n- Netzwerk-Editor\\r\\r\\n- KI-Vorschlag\\r\\r\\n\\r\\r\\nKI-generierte oder automatisch erkannte Routen werden zunächst als:\\r\\r\\n\\r\\r\\n```text\\r\\r\\nDRAFT\\r\\r\\nPENDING_CONFIRMATION\\r\\r\\n```\\r\\r\\n\\r\\r\\ngespeichert.\\r\\r\\n\\r\\r\\nErst der Benutzer bestätigt sie.\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 14. Netzwerk-Editor\\r\\r\\n\\r\\r\\nDer Netzwerk-Editor stellt grafisch dar:\\r\\r\\n\\r\\r\\n- 100 Sensoren\\r\\r\\n- 50 ECUs\\r\\r\\n- 1 Gateway\\r\\r\\n- LIN-Netze\\r\\r\\n- CAN-FD-Netze\\r\\r\\n- Ethernet-Netze\\r\\r\\n- Ports\\r\\r\\n- Interfaces\\r\\r\\n- Verbindungen\\r\\r\\n\\r\\r\\nZusätzlich:\\r\\r\\n\\r\\r\\n- Routing Overlay\\r\\r\\n- Signalpfade\\r\\r\\n- Message-Pfade\\r\\r\\n- Buslast\\r\\r\\n- Gateway-Auslastung\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 15. Parameter\\r\\r\\n\\r\\r\\nFür alle verwendeten Netzwerke werden technische Parameter definiert.\\r\\r\\n\\r\\r\\nBeispiele:\\r\\r\\n\\r\\r\\n- Bitrate\\r\\r\\n- Data Bitrate\\r\\r\\n- Payload\\r\\r\\n- MTU\\r\\r\\n- Cycle Time\\r\\r\\n- Timeout\\r\\r\\n- Priorität\\r\\r\\n- maximale Latenz\\r\\r\\n- Jitter\\r\\r\\n- Queueing\\r\\r\\n- Gateway Delay\\r\\r\\n- Protocol Overhead\\r\\r\\n- Reliability\\r\\r\\n- QoS\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 16. Capacity & Timing\\r\\r\\n\\r\\r\\nVor der Simulation werden berechnet:\\r\\r\\n\\r\\r\\n- Average Bus Load\\r\\r\\n- Peak Load\\r\\r\\n- Burst Load\\r\\r\\n- Capacity Reserve\\r\\r\\n- Message Load\\r\\r\\n- Route Load\\r\\r\\n- Gateway Load\\r\\r\\n- Queue Load\\r\\r\\n- Latenz\\r\\r\\n- End-to-End-Latenz\\r\\r\\n- Jitter\\r\\r\\n- Timing Reserve\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 17. Validation\\r\\r\\n\\r\\r\\nDas System prüft mindestens:\\r\\r\\n\\r\\r\\n- fehlende Producer\\r\\r\\n- fehlende Consumer\\r\\r\\n- unvollständige Signale\\r\\r\\n- fehlende Interfaces\\r\\r\\n- fehlerhafte Routingpfade\\r\\r\\n- nicht erreichbare ECUs\\r\\r\\n- Protokollinkompatibilitäten\\r\\r\\n- Busüberlast\\r\\r\\n- Gateway-Überlast\\r\\r\\n- Timingverletzungen\\r\\r\\n- Jitterverletzungen\\r\\r\\n- ungültige Signalbereiche\\r\\r\\n- doppelte Signale oder Routen\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 18. KI-Unterstützung\\r\\r\\n\\r\\r\\nDie KI unterstützt bei:\\r\\r\\n\\r\\r\\n- ECU-Definition\\r\\r\\n- Signaldefinition\\r\\r\\n- Interface-Erstellung\\r\\r\\n- Message-Erstellung\\r\\r\\n- Routing\\r\\r\\n- Parameter-Vorschlägen\\r\\r\\n- Fehleranalyse\\r\\r\\n- Capacity-Analyse\\r\\r\\n- Simulation\\r\\r\\n- Trace-Auswertung\\r\\r\\n\\r\\r\\nDie KI kann größere Workloads verarbeiten.\\r\\r\\n\\r\\r\\nBeispiel:\\r\\r\\n\\r\\r\\n```text\\r\\r\\nErzeuge für 50 ECUs\\r\\r\\nalle logisch notwendigen\\r\\r\\nEingangs- und Ausgangssignale.\\r\\r\\n```\\r\\r\\n\\r\\r\\nDer Agent zerlegt den Auftrag in Work Packages und prüft anschließend:\\r\\r\\n\\r\\r\\n- geforderte Menge\\r\\r\\n- erzeugte Menge\\r\\r\\n- gültige Menge\\r\\r\\n- fehlende Objekte\\r\\r\\n- Duplikate\\r\\r\\n- Fehler\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 19. Simulationsgrundlage\\r\\r\\n\\r\\r\\nDie Simulation verwendet keine beliebigen Zufallswerte.\\r\\r\\n\\r\\r\\nGrundlage sind:\\r\\r\\n\\r\\r\\n- Signalbereiche\\r\\r\\n- Einheiten\\r\\r\\n- Auflösungen\\r\\r\\n- Zykluszeiten\\r\\r\\n- Signalabhängigkeiten\\r\\r\\n- Funktionslogik\\r\\r\\n- Messages\\r\\r\\n- Routing\\r\\r\\n- Netzwerkparameter\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 20. Signalverhalten\\r\\r\\n\\r\\r\\nMögliche Signalprofile:\\r\\r\\n\\r\\r\\n- Constant\\r\\r\\n- Ramp\\r\\r\\n- Step\\r\\r\\n- Sine\\r\\r\\n- Pulse\\r\\r\\n- State dependent\\r\\r\\n- Formula based\\r\\r\\n- Lookup Table\\r\\r\\n- External Series\\r\\r\\n\\r\\r\\nDie Werte müssen innerhalb der Signaldefinitionen bleiben.\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 21. Golden Trace\\r\\r\\n\\r\\r\\nDie Simulation kann einen fehlerfreien:\\r\\r\\n\\r\\r\\n```text\\r\\r\\nGOLDEN TRACE\\r\\r\\n```\\r\\r\\n\\r\\r\\nerzeugen.\\r\\r\\n\\r\\r\\nEigenschaften:\\r\\r\\n\\r\\r\\n- plausible Signalwerte\\r\\r\\n- korrekte Signalauflösung\\r\\r\\n- korrekte Zykluszeiten\\r\\r\\n- konsistente Signalabhängigkeiten\\r\\r\\n- korrektes Routing\\r\\r\\n- keine künstlich injizierten Fehler\\r\\r\\n\\r\\r\\nDieser Trace dient als Referenz.\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 22. Fehlersimulation\\r\\r\\n\\r\\r\\nZusätzlich können Fehler eingebracht werden.\\r\\r\\n\\r\\r\\nSignalfehler:\\r\\r\\n\\r\\r\\n- Signal Stuck\\r\\r\\n- Drift\\r\\r\\n- Offset\\r\\r\\n- Spike\\r\\r\\n- Dropout\\r\\r\\n- Noise\\r\\r\\n- Frozen\\r\\r\\n- Out of Range\\r\\r\\n- Invalid Value\\r\\r\\n\\r\\r\\nKommunikationsfehler:\\r\\r\\n\\r\\r\\n- Message Loss\\r\\r\\n- Message Delay\\r\\r\\n- Message Jitter\\r\\r\\n- Message Corruption\\r\\r\\n- Message Duplication\\r\\r\\n- Timeout\\r\\r\\n- Wrong Cycle\\r\\r\\n\\r\\r\\nNetzwerkfehler:\\r\\r\\n\\r\\r\\n- Network Overload\\r\\r\\n- Gateway Delay\\r\\r\\n- Gateway Drop\\r\\r\\n- Queue Overflow\\r\\r\\n- Link Down\\r\\r\\n- Bus Off\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 23. Fehlerquellen\\r\\r\\n\\r\\r\\nFehlerszenarien können entstehen durch:\\r\\r\\n\\r\\r\\n- Benutzerdefinition\\r\\r\\n- vordefinierten Fault Catalog\\r\\r\\n- KI-Vorschlag\\r\\r\\n- seed-basierten Random-Fault-Modus\\r\\r\\n\\r\\r\\nKI-generierte Fehler werden zunächst als Proposal dargestellt und müssen bestätigt werden.\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 24. Simulation Views\\r\\r\\n\\r\\r\\nWährend der Simulation mindestens:\\r\\r\\n\\r\\r\\n### Network / ECU View\\r\\r\\n\\r\\r\\nDarstellung von:\\r\\r\\n\\r\\r\\n- ECUs\\r\\r\\n- Sensoren\\r\\r\\n- Gateway\\r\\r\\n- Busse\\r\\r\\n- Messages\\r\\r\\n- Datenfluss\\r\\r\\n\\r\\r\\n### Signal View\\r\\r\\n\\r\\r\\nDarstellung von:\\r\\r\\n\\r\\r\\n- Signalwert\\r\\r\\n- Verlauf\\r\\r\\n- Einheit\\r\\r\\n- Grenzwerten\\r\\r\\n- Warnungen\\r\\r\\n- Fault Markern\\r\\r\\n\\r\\r\\n### Bus Load View\\r\\r\\n\\r\\r\\nDarstellung von:\\r\\r\\n\\r\\r\\n- Current Load\\r\\r\\n- Average Load\\r\\r\\n- Peak Load\\r\\r\\n- Capacity Reserve\\r\\r\\n\\r\\r\\n### Events\\r\\r\\n\\r\\r\\nDarstellung von:\\r\\r\\n\\r\\r\\n- Warnings\\r\\r\\n- Errors\\r\\r\\n- Faults\\r\\r\\n- Timeouts\\r\\r\\n- Message Loss\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 25. Signalplot\\r\\r\\n\\r\\r\\nDer Nutzer kann Signale auswählen.\\r\\r\\n\\r\\r\\nBeispiel:\\r\\r\\n\\r\\r\\n```text\\r\\r\\nTemperature\\r\\r\\nMotorRPM\\r\\r\\nMotorCurrent\\r\\r\\nBatterySOC\\r\\r\\nWheelSpeed\\r\\r\\n```\\r\\r\\n\\r\\r\\nPlot enthält:\\r\\r\\n\\r\\r\\n- gemeinsame Zeitachse\\r\\r\\n- aktuelle Werte\\r\\r\\n- Min/Max\\r\\r\\n- Grenzwerte\\r\\r\\n- Warning Limits\\r\\r\\n- Error Limits\\r\\r\\n- Fault Marker\\r\\r\\n- Playhead\\r\\r\\n- Zoom\\r\\r\\n- Pan\\r\\r\\n\\r\\r\\nUnterschiedliche physikalische Einheiten werden vorzugsweise in separaten Signal-Lanes dargestellt.\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 26. Buslastvisualisierung\\r\\r\\n\\r\\r\\nPro Netzwerk:\\r\\r\\n\\r\\r\\n```text\\r\\r\\nCurrent Load\\r\\r\\nAverage Load\\r\\r\\nPeak Load\\r\\r\\nBurst Load\\r\\r\\nCapacity Reserve\\r\\r\\n```\\r\\r\\n\\r\\r\\nBeispiel:\\r\\r\\n\\r\\r\\n```text\\r\\r\\nCAN_FD_POWERTRAIN\\r\\r\\n\\r\\r\\nCurrent: 67 %\\r\\r\\nAverage: 58 %\\r\\r\\nPeak: 82 %\\r\\r\\nReserve: 33 %\\r\\r\\n```\\r\\r\\n\\r\\r\\nZusätzlich als Zeitreihe.\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 27. Results / Analysis\\r\\r\\n\\r\\r\\nNach Simulation:\\r\\r\\n\\r\\r\\n- Calculated vs Simulated Bus Load\\r\\r\\n- Signal Summary\\r\\r\\n- Timing Summary\\r\\r\\n- Jitter\\r\\r\\n- Latency\\r\\r\\n- Gateway Load\\r\\r\\n- Fault Summary\\r\\r\\n- Timeout Summary\\r\\r\\n- Routing Performance\\r\\r\\n- Critical Signals\\r\\r\\n- Critical Routes\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 28. Trace-Analyse\\r\\r\\n\\r\\r\\nJeder Simulationstrace kann direkt geöffnet werden in:\\r\\r\\n\\r\\r\\n```text\\r\\r\\nTRACE ANALYSE\\r\\r\\n```\\r\\r\\n\\r\\r\\nAblauf:\\r\\r\\n\\r\\r\\n```text\\r\\r\\nSimulation\\r\\r\\n→ Trace\\r\\r\\n→ Botschaften\\r\\r\\n→ Sequenz\\r\\r\\n→ Signale\\r\\r\\n→ Synchronisierter Trace\\r\\r\\n→ Findings\\r\\r\\n→ Root Cause\\r\\r\\n```\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 29. Data Science & Intelligence\\r\\r\\n\\r\\r\\nAuswertung des Gesamtsystems hinsichtlich:\\r\\r\\n\\r\\r\\n- System Health\\r\\r\\n- Network Quality\\r\\r\\n- Routing Quality\\r\\r\\n- Data Quality\\r\\r\\n- Timing Compliance\\r\\r\\n- Capacity Reserve\\r\\r\\n- Fehlerhäufigkeit\\r\\r\\n- Anomalien\\r\\r\\n- Bottlenecks\\r\\r\\n- Reifegrad\\r\\r\\n- Optimierungsvorschläge\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 30. Gesamtworkflow\\r\\r\\n\\r\\r\\n```text\\r\\r\\n1. Engineering-Modell\\r\\r\\n\\r\\r\\n2. Routing-Tabelle\\r\\r\\n\\r\\r\\n3. Netzwerk-Editor\\r\\r\\n\\r\\r\\n4. Parameter\\r\\r\\n\\r\\r\\n5. Capacity & Timing\\r\\r\\n\\r\\r\\n6. Validation\\r\\r\\n\\r\\r\\n7. Simulation\\r\\r\\n\\r\\r\\n8. Results / Analysis\\r\\r\\n\\r\\r\\n9. Data Science & Intelligence\\r\\r\\n```\\r\\r\\n\\r\\r\\n---\\r\\r\\n\\r\\r\\n## 31. Ziel des Musterprojekts\\r\\r\\n\\r\\r\\nDas Musterprojekt bildet damit eine skalierbare Fahrzeugarchitektur mit:\\r\\r\\n\\r\\r\\n```text\\r\\r\\n100 Sensoren\\r\\r\\n\\r\\r\\n50 Funktions-ECUs\\r\\r\\n\\r\\r\\n1 zentralen Gateway\\r\\r\\n\\r\\r\\n20 LIN\\r\\r\\n\\r\\r\\n10 CAN-FD\\r\\r\\n\\r\\r\\n5 Automotive Ethernet\\r\\r\\n```\\r\\r\\n\\r\\r\\nab.\\r\\r\\n\\r\\r\\nEs dient als Referenzsystem für:\\r\\r\\n\\r\\r\\n- Engineering-Modellierung\\r\\r\\n- Signalmodellierung\\r\\r\\n- Kommunikationsarchitektur\\r\\r\\n- Routing\\r\\r\\n- Netzwerktopologie\\r\\r\\n- Capacity & Timing\\r\\r\\n- Buslastberechnung\\r\\r\\n- KI-Agenten\\r\\r\\n- Workload-Orchestrierung\\r\\r\\n- realistische Simulation\\r\\r\\n- Fehlersimulation\\r\\r\\n- Trace-Analyse\\r\\r\\n- Data Science\\r\\r\\n- Systemreifegrad\\r\\r\\n- spätere EIP-Integration\\r\\r\\n\\r\\n\\r\\nVerbindliche Kanonisierung bei der Projektanlage: Pruefe vor jeder Hardware-Anlage vorhandene Systeme und verwende fachlich gleichwertige Hardware wieder. ADAS, Fahrerassistenz und Driver Assistance sind kontrollierte Synonyme desselben Systems. Eine gemeinsame Endung wie ECU ist kein Dublettenkriterium; fachlich verschiedene Systeme wie Abgasnachbehandlung und Airbag bleiben getrennt. Unterobjekte muessen an der wiederverwendeten kanonischen Hardware-ID angelegt werden.\\r\\n\\r\\nVerbindliche Systemcluster-Regel: Ausgewaehlte Cluster bilden fachliche Systemrahmen. Sensoren, Aktoren, Steuerungen, Interfaces, Nachrichten und Signale desselben Clusters muessen zusammen bewertet, auf das gewaehlte Netz abgebildet und bei Kapazitaetsproblemen als zusammenhaengendes System verteilt werden.\\r\\n\\r\\nVerbindlicher Kommunikationsplan: Jede Nachricht bekommt vor der Modellfreigabe ihren Zweck und ihre Empfaenger. Sensorwerte und Aktorrueckmeldungen gehen an den zugeordneten Controller, Befehle an den Aktor. Geraetestatus geht zur Diagnose, ersatzweise zum Gateway bzw. einem anderen Controller. Die Abgasnachbehandlung berichtet auch an die Motorsteuerung. Diese Defaults werden als Teil des Modellvorschlags geprueft.\\r\\n\\r\\nVerbindliche Anzeige-Routing-Regel: Nur in hmi_routes.signals eingeschaltete Funktionsausgaenge werden zur jeweiligen Anzeige geroutet. excluded_signals sind ausgeschaltet und duerfen nicht durch automatische Empfaengerdefaults wieder hinzugefuegt werden. Lokale Berechnungen, Sensor-/Aktor-Kommunikation und andere bestaetigte Funktionsempfaenger bleiben erhalten. Bei gemeinsamer Nachricht ist eine abweichende Signalteilmenge nur mit eigenem expliziten Payload zulaessig; keine DLC-Verkleinerung ohne neue Kodierung.\\r\\n\\r\\nVerbindliche Topologie-Regel: Systemrahmen sind kompakte Nachbarschaftsgruppen, keine ueber den ganzen View gezogenen Container. Ordne fachlich verwandte Rahmen nebeneinander an, fuehre Leitungen innerhalb und zwischen benachbarten Rahmen lokal, und gib Korrekturen des Nutzers als abstrakte Cluster-Nachbarschaften an den RAG-Kontext zurueck.\\r\\n\\r\\nStarte jetzt die Analyse und arbeite selbststaendig bis zum genannten Zielzustand. Nutze plausible Defaults, wenn Details fehlen, und frage nur bei echten fachlichen Entscheidungen oder Human Review erneut.\\r\\n\\r\\nSetze den bestaetigten Engineering-Auftrag am letzten erreichten Schritt fort. Lauf-ID: bf32c5c7-e5df-4931-937a-9db52571d5fd. Ziel: routing.\",\"wizard_command\":{\"action\":\"START\",\"run_id\":\"718fa925-3d0c-4a56-87d2-b302a352a9be\",\"operation_id\":\"7e72facf-a7d4-44fa-9eca-0d994febb9e7\",\"target\":\"data_science_intelligence\",\"wizard_context\":{\"attachments\":[{\"kind\":\"text/plain\",\"name\":\"neu 9.txt\",\"size\":11689,\"source\":\"task\"}],\"communication_system_counts\":[{\"count\":10,\"id\":\"can_fd\",\"label\":\"automotive · can_fd\",\"recognized\":10},{\"count\":25,\"id\":\"lin\",\"label\":\"automotive · lin\",\"recognized\":25},{\"count\":1,\"id\":\"someip\",\"label\":\"automotive · someip\",\"recognized\":0},{\"count\":5,\"id\":\"detected:ethernet\",\"label\":\"Ethernet\",\"recognized\":5}],\"confirmed_at\":\"2026-09-14T05:36:20.685Z\",\"hardware_counts\":{\"actuators\":250,\"ecus\":50,\"gateways\":1,\"sensors\":250},\"industry\":\"Automotive / Vehicle\",\"mode\":\"full\",\"model_type\":\"automotive\",\"network_architecture\":{\"ai_proposal\":\"\",\"approved\":true,\"approved_at\":\"2026-09-14T05:36:20.685Z\",\"id\":\"gateway_ecu_segments\",\"label\":\"Variante 4 · Gateway-Segmente\",\"rules\":\"Segmentierte Gateway-Backbone-Architektur: Sensoren und Aktoren werden fachlich an Controller geführt; pro Gateway-Leitung werden Controller entsprechend der einstellbaren Bus-Teilnehmergrenze als Bussegment gebündelt (Gateway mitgezählt). Das Gateway kennt die Controller-Segmente, legt aber keine Sensor-/Aktor-Direktanbindungen an.\"},\"notes\":\"\",\"parameters\":\"Technologie-Defaults verwenden\",\"planned_network_connections\":510,\"process\":[\"Leere Pflichtfelder mit technologieabhängigen Defaults füllen\",\"Selbstständig bis zum Human-Review-Gate arbeiten\",\"Nach einer menschlichen Freigabe valide Vorschläge direkt übernehmen\"],\"process_ids\":[\"defaults\",\"review_gate\",\"approve_after_allow\"],\"project_name\":\"NIS Projekt 2\",\"scope\":[\"Workflow 1 Engineering-Modell: HardwareNodes, Functions, Interfaces, Messages, Signals und Relations anlegen\",\"Workflow 2 Routing-Tabelle: Kommunikationspfade mit Producer, Consumer, Payload, Signal, Gateway, Protokoll und Pfad erstellen\",\"Workflow 3 Netzwerk-Editor: physische Topologie, Ports, Verbindungen und Gateway-Uebergaenge erzeugen\",\"Workflow 4 Parameter: technologieabhaengige Bitrate, Payload, Zyklus, Latenz, Jitter, Queueing und Safety-Defaults setzen\",\"Workflow 5 Capacity & Timing: Last, Reserve, Gateway-Load, E2E-Latenz, Bottlenecks und Timing berechnen\",\"Workflow 6 Validation/Preflight: Konsistenz, fehlende Interfaces, Payloads, Duplikate und Blocker pruefen\",\"Workflow 7 Simulation: Simulationssnapshot nach aktuellem erfolgreichem Preflight anlegen\",\"Workflow 8 Results/Analysis: Simulationsergebnisse, Artefakte, Nachweise und Ergebnisvergleich auswerten\",\"Workflow 9 Data Science & Intelligence: Systembewertung, Reifegrad, Issues, Anomalien und Optimierungsvorschlaege erzeugen\"],\"scope_ids\":[\"engineering_model\",\"routing\",\"network_editor\",\"parameters\