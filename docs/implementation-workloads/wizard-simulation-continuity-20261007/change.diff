+def _parameter_scope_key(technology, network_id, configuration, metadata):
+    """Only equal native inputs may share a request-local resolution.
+
+    Canonical object IDs, channel names and audit timestamps are not native
+    parameter inputs. Evidence, nested capabilities and assumptions remain
+    part of the key, as do every registered parameter and ingress alias.
