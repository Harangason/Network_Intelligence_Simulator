+    if technology not in metadata:
+        definition = DEFAULT_TECHNOLOGY_REGISTRY.profile(technology, fields=(
+            'parameter_aliases', 'native_parameter_prefixes'))
+        keys = DEFAULT_TECHNOLOGY_REGISTRY.parameter_keys() | set(PARAMETER_UI_ALIASES.values())
+        keys.update(definition.get('parameter_aliases') or {})
+        keys.update({'technology', 'protocol', 'defaults_source', 'parameter_provenance',
+                     'simulation_parameter_assumptions', 'capabilities', 'local_timing_evidence'})
+        metadata[technology] = keys, tuple(definition.get('native_parameter_prefixes') or ())
+    keys, prefixes = metadata[technology]
+    facts = {key: value for key, value in configuration.items()
+             if key in keys or prefixes and key.startswith(prefixes)}
+    return technology, network_id, json.dumps(facts, sort_keys=True, default=str)
