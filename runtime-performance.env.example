# Local AI provider used by the Studio agent and simulator helpers.
AI_PROVIDER=hybrid-demand
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=qwen3.8:27b
LOCAL_AI_API_KEY=ollama
CLOUD_ESCALATION=on_failure
OLLAMA_MODELS=I:\engineering-intelligence-platform\models\ollama
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=10m
NETWORKIS_SHARED_ENV_FILE=C:\Users\<username>\PycharmProjects\.env

# Ryzen 9 5950X baseline: reserve capacity for Windows, Next.js and Ollama.
WAITRESS_THREADS=16
SIMULATION_EXECUTOR=process
SIMULATION_WORKERS=12

# Avoid nested CPU oversubscription inside worker processes.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

# Set to 0 for supervised/background starts that should not open another browser tab.
NETWORKIS_OPEN_BROWSER=1

# Optional cloud providers. hybrid-demand keeps both providers dormant until
# they are explicitly requested or a failed local run is deliberately resumed.
NVIDIA_AI_MODEL=nvidia/nemotron-3-nano-30b-a3b
OPENAI_AI_MODEL=gpt-5-mini
