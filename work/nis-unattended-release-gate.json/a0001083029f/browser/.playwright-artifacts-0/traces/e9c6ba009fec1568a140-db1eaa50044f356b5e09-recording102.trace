ie bestätigte Beschreibung bleibt nachvollziehbar. Ergänzungen und Korrekturen kannst du unten speichern."],["LABEL",{},"Einsatzbereich",["INPUT",{"__playwright_value_":"embedded_systems","value":"embedded_systems"}]],["DIV",{"class":"project-draft-editor-module__0Bgx1G__devices"},["FIELDSET",{},["LEGEND",{},"RaspberryPi"," · ","CONTROLLER"],["BUTTON",{"type":"button","class":"button secondary"},"Aus Entwurf entfernen"],["LABEL",{},"Name",["INPUT",{"__playwright_value_":"RaspberryPi","value":"RaspberryPi"}]],["LABEL",{},"Messgröße oder Geräteaufgabe",["INPUT",{"__playwright_value_":"","placeholder":"Zum Beispiel: Temperatur messen","value":""}]],["LABEL",{},"Anschlusstechnologie",["INPUT",{"__playwright_value_":"ethernet","placeholder":"Noch offen","value":"ethernet"}]]],["FIELDSET",{},["LEGEND",{},"Temperatursensor1"," · ","SENSOR"],["BUTTON",{"type":"button","class":"button secondary"},"Aus Entwurf entfernen"],["LABEL",{},"Name",["INPUT",{"__playwright_value_":"Temperatursensor1","value":"Temperatursensor1"}]],["LABEL",{},"Messgröße oder Geräteaufgabe",["INPUT",{"__playwright_value_":"","placeholder":"Zum Beispiel: Temperatur messen","value":""}]],["LABEL",{},"Verarbeitender Controller",["SELECT",{},["OPTION",{"__playwright_selected_":"false","value":""},"Noch offen"],["OPTION",{"__playwright_selected_":"true","value":"a24f839b0f4fb34ce640"},"RaspberryPi"]]],["LABEL",{},"Anschlusstechnologie",["INPUT",{"__playwright_value_":"ethernet","placeholder":"Noch offen","value":"ethernet"}]]],["FIELDSET",{},["LEGEND",{},"Temperatursensor2"," · ","SENSOR"],["BUTTON",{"type":"button","class":"button secondary"},"Aus Entwurf entfernen"],["LABEL",{},"Name",["INPUT",{"__playwright_value_":"Temperatursensor2","value":"Temperatursensor2"}]],["LABEL",{},"Messgröße oder Geräteaufgabe",["INPUT",{"__playwright_value_":"","placeholder":"Zum Beispiel: Temperatur messen","value":""}]],["LABEL",{},"Verarbeitender Controller",["SELECT",{},["OPTION",{"__playwright_selected_":"false","value