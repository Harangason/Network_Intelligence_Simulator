n erhalten."],["CODE",{"aria-label":"Schema Variante 0 · Sensor-Controller-Aktor"},"Sensor -> Controller -> Aktor"]]],["LABEL",{"class":"agent-architecture-choice "},["INPUT",{"__playwright_value_":"on","__playwright_checked_":"false","type":"radio","name":"network-architecture"}],["SPAN",{"class":"agent-architecture-copy"},["STRONG",{},"Variante 1 · Einfaches EVA"],["SMALL",{},"Eingabe, Verarbeitung und Ausgabe bleiben je System und Controller fachlich zusammengefasst."],["CODE",{"aria-label":"Schema Variante 1 · Einfaches EVA"},"Sensor/Aktor → Controller → Gateway"]]],["LABEL",{"class":"agent-architecture-choice "},["INPUT",{"__playwright_value_":"on","__playwright_checked_":"false","type":"radio","name":"network-architecture"}],["SPAN",{"class":"agent-architecture-copy"},["STRONG",{},"Variante 2 · Controller-vermittelt"],["SMALL",{},"Sensoren und Aktoren hängen am zuständigen Controller; der Controller kommuniziert mit dem Gateway."],["CODE",{"aria-label":"Schema Variante 2 · Controller-vermittelt"},"Sensor ─┐\n        ├─ Controller ─ Gateway\nAktor ──┘"]]],["LABEL",{"class":"agent-architecture-choice "},["INPUT",{"__playwright_value_":"on","__playwright_checked_":"false","type":"radio","name":"network-architecture"}],["SPAN",{"class":"agent-architecture-copy"},["STRONG",{},"Variante 3 · Gateway-direkt"],["SMALL",{},"Sensoren, Controller und Aktoren erhalten jeweils eine direkte Gateway-Anbindung."],["CODE",{"aria-label":"Schema Variante 3 · Gateway-direkt"},"Sensor ─────┐\nController ─┼─ Gateway\nAktor ──────┘"]]],["LABEL",{"class":"agent-architecture-choice "},["INPUT",{"__playwright_value_":"on","__playwright_checked_":"false","type":"radio","name":"network-architecture"}],["SPAN",{"class":"agent-architecture-copy"},["STRONG",{},"Variante 4 · Gateway-Segmente"],["SMALL",{},"Gemeinsame Gateway-Busse gemäß den Teilnehmergrenzen je Bustyp; Sensoren und Aktoren bleiben an der fachlichen Steuerung."],["CODE",{"aria-label":"Schema Variante 4 · Gateway-Segmente"},"Sensor/Aktor -> Controller 1 --\\\nSensor/Aktor -> Controller 2 --- Gateway\n... weitere Controller ----/"]]],["LABEL",{"class":"agent-architecture-choice "},["INPUT",{"__playwright_value_":"on","__playwright_checked_":"false","type":"radio","name":"network-architecture"}],["SPAN",{"class":"agent-architecture-copy"},["STRONG",{},"KI-Kombination · Variante 2 + 3"],["SMALL",{},"Die KI entscheidet je Teilnehmer zwischen lokaler Controller-Zuordnung und direkter Gateway-Anbindung."],["CODE",{"aria-label":"Schema KI-Kombination · Variante 2 + 3"},"lokal → Controller ─┐\n                    ├─ Gateway\ndirekt ─────────────┘"]]],["LABEL",{"class":"agent-architecture-choice "},["INPUT",{"__playwright_value_":"on","__playwright_checked_":"false","type":"radio","name":"network-architecture"}],["SPAN",{"class":"agent-architecture-copy"},["STRONG",{},"Variante 4 + KI 2+3 · Segmente und direkte Teilnehmer"],["SMALL",{},"Controller teilen sich begrenzte Gateway-Segmente; geeignete Teilnehmer können nach fachlicher Prüfung direkt am Gateway liegen."],["CODE",{"aria-label":"Schema Variante 4 + KI 2+3 · Segmente und direkte Teilnehmer"},"lokal → Controller ─ Segment ─┐\ndirekt ────────────────────────┴─ Gateway"]]]],["DIV",{"class":"agent-architecture-ai"},["DIV",{},["STRONG",{},"KI-Architekturentwurf"],["SMALL",{},"Erstellt eine prüfbare Kombination aus Architekturvarianten. PDF, PowerPoint, Bilder, SVG und Text können als Evidence einfließen."]],["DIV",{"class":"agent-architecture-ai-actions"},["LABEL",{"class":"button secondary tiny agent-file-button"},["INPUT",{"__playwright_value_":"","accept":".txt,.md,.csv,.json,.svg,.pdf,.doc,.docx,.ppt,.pptx,.png,.jpg,.jpeg,.webp,.gif,.bmp,text/*,image/*,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation","multiple":"","type":"file"}],"Evidence hinzufügen"],["BUTTON",{"class":"button s