_Thermik_07 (19 Teilnehmer); Infotainment -> Ethernet / Infotainment_08 (46 Teilnehmer); Diagnose -> Ethernet / Diagnose_09 (9 Teilnehmer); Regelung -> Ethernet / Regelung_10 (95 Teilnehmer)\r\n- Bus-Teilnehmergrenzen: {\"can\":64,\"can_fd\":64,\"can_xl\":64,\"lin\":64,\"automotive_ethernet\":256,\"flexray\":64}\r\n- Systemcluster-Graph: [{\"cluster_id\":\"family:powertrain\",\"label\":\"Antriebsstrang\",\"network_id\":\"can_fd\",\"network_label\":\"automotive Â· can_fd\",\"bus_name\":\"Antriebsstrang_01\",\"controllers\":[{\"ecu\":\"Abgasnachbehandlung\",\"sensors\":[\"AbgasnachbehandlungHealthFeedback\",\"AbgasnachbehandlungOperatingState\",\"AbgasnachbehandlungPrimaryFeedback\",\"EGRValvePosition\",\"ExhaustGasTemperature\",\"UreaLevel\"],\"actuators\":[\"AbgasnachbehandlungEnableCommand\",\"AbgasnachbehandlungPrimaryCommand\",\"AbgasnachbehandlungSafetyCommand\",\"AbgasnachbehandlungSchaltausgang\",\"AbgasnachbehandlungStellglied\"]},{\"ecu\":\"Elektromotorsteuerung\",\"sensors\":[\"ElektromotorsteuerungHealthFeedback\",\"ElektromotorsteuerungOperatingState\",\"ElektromotorsteuerungPrimaryFeedback\",\"MotorCurrent\",\"MotorSpeed\",\"MotorTemperature\"],\"actuators\":[\"ElektromotorsteuerungEnableCommand\",\"ElektromotorsteuerungPrimaryCommand\",\"ElektromotorsteuerungSafetyCommand\",\"ElektromotorsteuerungSchaltausgang\",\"ElektromotorsteuerungStellglied\"]},{\"ecu\":\"Getriebesteuerung\",\"sensors\":[\"ClutchPosition\",\"GearSelectorPosition\",\"GetriebesteuerungHealthFeedback\",\"GetriebesteuerungOperatingState\",\"GetriebesteuerungPrimaryFeedback\",\"TransmissionInputSpeed\",\"TransmissionOilTemperature\",\"TransmissionOutputSpeed\"],\"actuators\":[\"GetriebesteuerungEnableCommand\",\"GetriebesteuerungPrimaryCommand\",\"GetriebesteuerungSafetyCommand\",\"GetriebesteuerungSchaltausgang\",\"GetriebesteuerungStellglied\"]},{\"ecu\":\"Invertersteuerung\",\"sensors\":[\"DCLinkVoltage\",\"InvertersteuerungHealthFeedback\",\"InvertersteuerungOperatingState\",\"Inver