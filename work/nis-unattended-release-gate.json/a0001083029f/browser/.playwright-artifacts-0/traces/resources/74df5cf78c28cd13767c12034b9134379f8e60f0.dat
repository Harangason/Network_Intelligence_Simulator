ors\":[\"FrontCamera\",\"KameraverarbeitungHealthFeedback\",\"KameraverarbeitungOperatingState\",\"KameraverarbeitungPrimaryFeedback\",\"RearCamera\",\"SurroundLeftCamera\",\"SurroundRightCamera\"],\"actuators\":[\"KameraverarbeitungEnableCommand\",\"KameraverarbeitungPrimaryCommand\",\"KameraverarbeitungSafetyCommand\",\"KameraverarbeitungSchaltausgang\",\"KameraverarbeitungStellglied\"]},{\"ecu\":\"Parkassistenz\",\"sensors\":[\"ParkassistenzHealthFeedback\",\"ParkassistenzOperatingState\",\"ParkassistenzPrimaryFeedback\"],\"actuators\":[\"ParkassistenzEnableCommand\",\"ParkassistenzPrimaryCommand\",\"ParkassistenzSafetyCommand\",\"ParkassistenzSchaltausgang\",\"ParkassistenzStellglied\"]},{\"ecu\":\"Radarverarbeitung\",\"sensors\":[\"FrontRadarDistance\",\"RadarverarbeitungHealthFeedback\",\"RadarverarbeitungOperatingState\",\"RadarverarbeitungPrimaryFeedback\",\"RearRadarDistance\"],\"actuators\":[\"RadarverarbeitungEnableCommand\",\"RadarverarbeitungPrimaryCommand\",\"RadarverarbeitungSafetyCommand\",\"RadarverarbeitungSchaltausgang\",\"RadarverarbeitungStellglied\"]},{\"ecu\":\"Stabilitaetsregelung\",\"sensors\":[\"FrontLeftWheelAcceleration\",\"FrontLeftWheelLoad\",\"FrontLeftWheelSpeed\",\"FrontLeftWheelTorque\",\"FrontRightWheelAcceleration\",\"FrontRightWheelLoad\",\"FrontRightWheelSpeed\",\"FrontRightWheelTorque\",\"LateralAcceleration\",\"LongitudinalAcceleration\",\"PitchRate\",\"RearLeftWheelAcceleration\",\"RearLeftWheelLoad\",\"RearLeftWheelSpeed\",\"RearLeftWheelTorque\",\"RearRightWheelAcceleration\",\"RearRightWheelLoad\",\"RearRightWheelSpeed\",\"RearRightWheelTorque\",\"RollRate\",\"StabilitaetsregelungHealthFeedback\",\"StabilitaetsregelungOperatingState\",\"StabilitaetsregelungPrimaryFeedback\",\"VerticalAcceleration\",\"YawRate\"],\"actuators\":[\"StabilitaetsregelungEnableCommand\",\"StabilitaetsregelungPrimaryCommand\",\"StabilitaetsregelungSafetyCommand\",\"StabilitaetsregelungSchaltausgang\",\"StabilitaetsregelungStellglied\"]},{\"ecu\":\"Thermomanagement\",\"sensors\":[\"ThermomanagementHealthFeedback\",\"ThermomanagementOperatingState\",\"ThermomanagementPrimaryFeedback\"],\"actuators\":[\"ThermomanagementEnableCommand\",\"ThermomanagementPrimaryCommand\",\"ThermomanagementSafetyCommand\",\"ThermomanagementSchaltausgang\",\"ThermomanagementStellglied\"]},{\"ecu\":\"Ultraschallverarbeitung\",\"sensors\":[\"FrontLeftUltrasonicDistance\",\"FrontRightUltrasonicDistance\",\"RearLeftUltrasonicDistance\",\"RearRightUltrasonicDistance\",\"UltraschallverarbeitungHealthFeedback\",\"UltraschallverarbeitungOperatingState\",\"UltraschallverarbeitungPrimaryFeedback\"],\"actuators\":[\"UltraschallverarbeitungEnableCommand\",\"UltraschallverarbeitungPrimaryCommand\",\"UltraschallverarbeitungSafetyCommand\",\"UltraschallverarbeitungSchaltausgang\",\"UltraschallverarbeitungStellglied\"]}],\"unassigned\":[],\"hmi_routes\":[{\"source\":\"Drehmomentkoordination\",\"target\":\"Kombiinstrument\",\"signals\":[],\"excluded_signals\":[\"DrehmomentkoordinationStatus\"],\"path\":[\"Drehmomentkoordination\",\"Ethernet\",\"Gateway\",\"Kombiinstrument\"]},{\"source\":\"Drehmomentkoordination\",\"target\":\"Infotainment\",\"signals\":[],\"excluded_signals\":[\"DrehmomentkoordinationStatus\"],\"path\":[\"Drehmomentkoordination\",\"Ethernet\",\"Gateway\",\"Infotainment\"]},{\"source\":\"Drehmomentkoordination\",\"target\":\"HeadUpDisplay\",\"signals\":[],\"excluded_signals\":[\"DrehmomentkoordinationStatus\"],\"path\":[\"Drehmomentkoordination\",\"Ethernet\",\"Gateway\",\"HeadUpDisplay\"]},{\"source\":\"Kameraverarbeitung\",\"target\":\"Kombiinstrument\",\"signals\":[],\"excluded_signals\":[\"KameraverarbeitungStatus\"],\"path\":[\"Kameraverarbeitung\",\"Ethernet\",\"Gateway\",\"Kombiinstrument\"]},{\"source\":\"Kameraverarbeitung\",\"target\":\"Infotainment\",\"signals\":[],\"excluded_signals\":[\"KameraverarbeitungStatus\"],\"path\":[\"Kameraverarbeitung\",\"Ethernet\",\"Gateway\",\"Infotainment\"]},{\"source\":\"Kameraverarbeit